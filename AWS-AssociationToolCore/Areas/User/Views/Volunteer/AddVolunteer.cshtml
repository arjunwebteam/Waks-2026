            url: '@Url.Action("GetStatesByCountryID", "Volunteer")',
            type: 'POST',
            data: { CountryID: CountryID }, // optional data
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var sb = "<option value=\"\">-- Select --</option>";
                    States = result.data;
                    if (States != null) {
                        for (var i = 0; i < States.length; i++) {
