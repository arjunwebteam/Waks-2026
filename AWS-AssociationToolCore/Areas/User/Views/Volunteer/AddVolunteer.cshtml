    function onRecaptchaSuccess(token) {
        $("#recaptchaResponse").val(token);
         $("#recaptchaResponse").valid();
    }



      function PhoneNochange(event) {

        if (event.keyCode == 8 || event.keyCode == 46) {
            return;
        }

        var ph = $('#PhoneNo').val().replace(/\D/g, '');

        if (ph.length > 7) {
            $('#PhoneNo').val(
                ph.substring(0, 4) + ' ' +
                ph.substring(4, 7) + ' ' +
                ph.substring(7, 10)
            );
        }
        else if (ph.length > 4) {
            $('#PhoneNo').val(
                ph.substring(0, 4) + ' ' +
                ph.substring(4)
            );
        }
        else {
            $('#PhoneNo').val(ph);
        }
    }

    function cphonenochange(event) {
        if (event.keyCode == 8 || event.keyCode == 46) {
        }
        else {
            var ph = $('#SelfPhoneNo').val();
            if (ph.length == 3) { $('#SelfPhoneNo').val(ph + '-'); }
            if (ph.length == 7) { $('#SelfPhoneNo').val(ph + '-'); }
        }
    }

</script>
<script type="text/javascript">
$(document).ready(function () {

    // ✅ 1 — formatPhone function
       function formatPhone(val) {
            var ph = val.replace(/\D/g, '');

            if (ph.length > 7)
                return ph.slice(0,4) + ' ' + ph.slice(4,7) + ' ' + ph.slice(7,10);

            if (ph.length > 4)
                return ph.slice(0,4) + ' ' + ph.slice(4);

            return ph;
        }
    // ✅ 2 — Phone formatting on input
    $('#PhoneNo').on('input', function () {
        $(this).val(formatPhone($(this).val()));
    });

    // ✅ 3 — Define custom phoneFormat rule
           $.validator.addMethod("phoneFormat", function (value, element) {

            var phone = value.replace(/\s/g, '');

            return this.optional(element) || /^04\d{8}$/.test(phone);

        }, "Please enter a valid Australian mobile number");

    // ✅ 4 — Define custom validate_email rule
    $.validator.addMethod("validate_email", function (value, element) {
        return this.optional(element) || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value);
    }, "Please enter valid email address");
$.validator.addMethod("atLeastOneInterest", function (value, element) {
    var waksChecked = $('input[name="WaksCategory"]:checked').length > 0;
    var kannadaChecked = $('input[name="KannadaCategory"]:checked').length > 0;
    return waksChecked || kannadaChecked;
}, "Please select at least one option from Waks or Kannada Shaale section below.");
    $.validator.addMethod("validate_email", function (value, element) {
        return this.optional(element) || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value);
    }, "Please enter valid email address");

    // ❌ atLeastOneWaks method తీసేయచ్చు (అవసరం లేదు ఇప్పుడు)

$("#VolunteerForm").validate({
    rules: {
        FirstName:   "required",
        LastName:    "required",
        Email:       { required: true, validate_email: true },
        PhoneNo:     { required: true, phoneFormat: true },
        State:       "required",
        Country:     "required",
        City:        "required",
        ItemValue:   "required",
        InterestCheck: {           // ✅ ఇక్కడ కలుపు — తక్కిన fields లాగే ఒకే పాస్ లో check అవుతుంది
            atLeastOneInterest: true
        },
        recaptcha: {
            required: function () {
                var capcha = '@capcha';
                return capcha === 'Yes' && $("#recaptchaResponse").val().trim() === "";
            }
        }
    },
    messages: {
        FirstName:   "Please enter your first name",
        LastName:    "Please enter your last name",
        Email: {
            required:       "Please enter email address",
            validate_email: "Please enter valid email address"
        },
        PhoneNo: {
            required:    "Please enter phone number",
            phoneFormat: "Please enter valid phone number (0421 151 439)"
        },
        State:     { required: "Please select state" },
        Country:   { required: "Please select country" },
        City:      { required: "Please enter city" },
        ItemValue: { required: "Please accept Terms & Conditions" },
        InterestCheck: { atLeastOneInterest: "Please select at least one option from Waks or Kannada Shaale section Above." },
        recaptcha: { required: "Please confirm that you are not a robot." }
    },

    errorPlacement: function (error, element) {
        error.addClass("help-block");
        var name = element.attr("name");

        if (name === "InterestCheck") {
            $("#spanInterest").html("").append(error).show();
            return;
        }
        if (name === "ItemValue") {
            $("#spanItemValue").html("").append(error);
            return;
        }
        if (name === "recaptcha") {
            error.css("color", "#c0392b").css("font-size", "13px");
            error.insertAfter(".g-recaptcha");
            return;
        }
        error.insertAfter(element);
    },

    highlight: function (element, errorClass, validClass) {
        var name = $(element).attr("name");
        if (name === "ItemValue" || name === "InterestCheck") return;
        $(element).closest("fieldset").addClass("has-error").removeClass("has-success");
    },
    unhighlight: function (element, errorClass, validClass) {
        var name = $(element).attr("name");
        if (name === "ItemValue" || name === "InterestCheck") return;
        $(element).closest("fieldset").addClass("has-success").removeClass("has-error");
    },

    submitHandler: function (form) {
        var waksVal = [];
        $('input[name="WaksCategory"]:checked').each(function () {
            waksVal.push($(this).val());
        });
        var waksCombined = waksVal.length > 0 ? waksVal.join(",") : "";

        var kannadaVal = $('input[name="KannadaCategory"]:checked').val() || "0";

        $('#hdnWaksCategory').val(waksCombined);
        $('#hdnKannadaCategory').val(kannadaVal);

        $('#VolunteerCategories').val(waksCombined + ',' + kannadaVal);

        form.submit();
    }
});

    // ✅ Waks checkbox change → re-validate
    $('input[name="WaksCategory"]').on('change', function () {
        $('#InterestCheck').valid();
    });


    var lastKannadaChecked = null;

    $('input[name="KannadaCategory"]').on('click', function () {
        if (this === lastKannadaChecked) {
            $(this).prop('checked', false);
            lastKannadaChecked = null;
        } else {
            lastKannadaChecked = this;
        }
        $('#InterestCheck').valid();
    });
        });



</script>
