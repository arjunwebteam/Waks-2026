@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.AspNetCore.Http
@{
    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);





    var location = System.Configuration.ConfigurationManager.AppSettings["adminimgurl"] + "MemberProfileImages/";


    AWS_AssociationToolCore.Entities.EventRegTickets objEventRegTickets = ViewBag.objEventRegTickets;

    var imglocNormal = System.Configuration.ConfigurationManager.AppSettings["adminimgurl"] + "Content/CulturalEvent/";

    var type = ViewBag.type;
    var uid = ViewBag.uid;
    var MembershipType = ViewBag.MembershipType;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Individual Ticket Check-in - @objAppInfo.SiteName</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 10px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #c81515, #e53e3e);
            color: white;
            padding: 15px 20px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
        }

            .header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" fill="white" opacity="0.1"><polygon points="0,100 1000,0 1000,100"/></svg>');
                background-size: cover;
            }

        .header-logo {
            display: flex;
            align-items: center;
            gap: 15px;
            z-index: 1;
            position: relative;
        }

        .logo-container {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .logo-icon {
            width: 30px;
            height: 30px;
            fill: white;
        }

        .header-content {
            text-align: center;
            flex: 1;
            z-index: 1;
            position: relative;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1;
            position: relative;
        }

        .login-btn {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

            .login-btn:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: translateY(-1px);
            }

        .header h1 {
            font-size: 1.6rem;
            font-weight: 300;
            margin-bottom: 5px;
        }

        .header p {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .content {
            padding: 25px;
        }

        .ticket-overview {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            border-left: 5px solid #c81515;
        }

        .ticket-header {
            gap: 10px;
            align-items: center;
            display: flex;
            padding-bottom: 30px;
        }
        .ticket-label.pn {
            padding-left: 180px;
        }

        .ticket-id-display {
            font-family: 'Courier New', monospace;
            font-size: 1.5rem;
            font-weight: bold;
            color: #c81515;
            background: white;
            padding: 12px 20px;
            border-radius: 8px;
            border: 2px solid #c81515;
        }

        .ticket-status-large {
            padding: 12px 25px;
            border-radius: 25px;
            font-size: 1.1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-checked-in {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-pending {
            background: #fef5e7;
            color: #c05621;
        }

        .ticket-details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .detail-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .detail-value {
            font-size: 1rem;
            font-weight: 500;
            color: #2d3748;
            padding: 10px 12px;
            background: white;
            border-radius: 6px;
            border-left: 3px solid #c81515;
        }

        .section {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #c81515;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-title::before {
                content: '';
                width: 15px;
                height: 15px;
                background: linear-gradient(135deg, #c81515, #e53e3e);
                border-radius: 50%;
            }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .info-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .info-value {
            font-size: 0.85rem;
            font-weight: 500;
            color: #2d3748;
            padding: 10px 12px;
            background: #f7fafc;
            border-radius: 6px;
            border-left: 3px solid #c81515;
        }

        .checkin-form {
            background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
            border-radius: 15px;
            padding: 30px;
            border: 2px solid #667eea;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .form-select,
        .form-textarea {
            width: 100%;
            padding: 15px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            background: white;
        }

            .form-select:focus,
            .form-textarea:focus {
                outline: none;
                border-color: #c81515;
                box-shadow: 0 0 0 3px rgba(200, 21, 21, 0.1);
            }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .button-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 25px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, #c81515, #e53e3e);
            color: white;
            box-shadow: 0 4px 15px rgba(200, 21, 21, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(200, 21, 21, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #718096, #4a5568);
            color: white;
            box-shadow: 0 4px 15px rgba(113, 128, 150, 0.3);
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(113, 128, 150, 0.4);
            }

        .btn-success {
            background: linear-gradient(135deg, #48bb78, #38a169);
            color: white;
            box-shadow: 0 4px 15px rgba(72, 187, 120, 0.3);
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
            }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .alert-warning {
            background: #fef5e7;
            color: #c05621;
            border: 1px solid #f6e05e;
        }

        .checkin-history {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
        }

        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #e2e8f0;
        }

            .history-item:last-child {
                border-bottom: none;
            }

        .history-action {
            font-weight: 600;
            color: #2d3748;
        }

        .history-time {
            font-size: 0.9rem;
            color: #718096;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #c81515;
            text-decoration: none;
            font-weight: 500;
            margin-bottom: 20px;
            padding: 8px 15px;
            border-radius: 20px;
            background: rgba(200, 21, 21, 0.1);
            transition: all 0.3s ease;
        }

            .back-link:hover {
                background: rgba(200, 21, 21, 0.2);
                transform: translateX(-3px);
            }

        @@media (max-width: 768px) {
            body {
                padding: 5px;
            }

            .content {
                padding: 15px;
            }

            .ticket-overview {
                padding: 20px;
            }

            .ticket-header {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }

            .ticket-id-display {
                font-size: 1.2rem;
                padding: 10px 15px;
            }

            .ticket-details-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .info-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .button-group {
                flex-direction: column;
            }

            .btn {
                padding: 12px 25px;
                font-size: 1rem;
            }

            .checkin-form {
                padding: 20px;
            }
        }


        /* Login Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
        }

            .modal.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: white;
            margin: 20px;
            padding: 0;
            border-radius: 15px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            animation: modalSlideIn 0.3s ease;
            overflow: hidden;
        }

        @@keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px) scale(0.9);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            background: linear-gradient(135deg, #c81515, #e53e3e);
            color: white;
            padding: 20px;
            text-align: center;
            position: relative;
        }

            .modal-header h2 {
                margin: 0;
                font-size: 1.3rem;
                font-weight: 500;
            }

        .close {
            position: absolute;
            right: 15px;
            top: 15px;
            color: white;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s ease;
        }

            .close:hover {
                background-color: rgba(255, 255, 255, 0.2);
            }

        .modal-body {
            padding: 25px;
        }

        .login-form-group {
            margin-bottom: 20px;
        }

        .login-form-label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .login-form-input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            background: white;
            box-sizing: border-box;
        }

            .login-form-input:focus {
                outline: none;
                border-color: #c81515;
                box-shadow: 0 0 0 3px rgba(200, 21, 21, 0.1);
            }

        .login-submit-btn {
            width: 100%;
            background: linear-gradient(135deg, #c81515, #e53e3e);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(200, 21, 21, 0.3);
        }

            .login-submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(200, 21, 21, 0.4);
            }

        .forgot-password {
            text-align: center;
            margin-top: 15px;
        }

            .forgot-password a {
                color: #c81515;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .forgot-password a:hover {
                    text-decoration: underline;
                }

        .login-note {
            background: #e6fffa;
            border: 1px solid #81e6d9;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            color: #234e52;
        }

        .login-link {
            color: #c81515;
            text-decoration: none;
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: border-bottom-color 0.3s ease;
        }

            .login-link:hover {
                border-bottom-color: #c81515;
            }
            @@media only screen and (max-width:450px){
                .ticket-label.pn {
                    padding-left: 0px;
                }

}
    </style>
    <script type="text/javascript">
        $(document).ready(function () {

            if ('@ViewBag.strcul' == 'login-failed') {
                CulLoginShow();
                $('#ErrorMessageCul').show();
            }
            $('#newsshow').hide();
            $('#hideleft').hide();

        });

        function CulLoginShow() {
            $('#EmailC1').val('').removeClass('validate');
            $('#PasswordC1').val('').removeClass('validate');
            $('#ErrorMessageCul').hide();
            $('#cullogin').dialog('open');
        }

    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            Common.mfadeout();

        });

        function CulLoginValidate() {
            if ($('#EmailC1').val() == "") { $('#EmailC1').focus().addClass("validate"); return false; } else { $('#EmailC1').removeClass("validate"); }
            if (!Common.CheckEmail($('#EmailC1').val())) { $('#EmailC1').val(''); document.getElementsByName('Email')[0].placeholder = 'Invalid email address'; $('#EmailC1').focus().addClass("validate"); return false; } else { $('#EmailC1').removeClass("validate"); }
            if ($('#PasswordC1').val() == '') { $('#PasswordC1').focus().addClass("validate"); return false; } else { $('#PasswordC1').focus().removeClass("validate"); }


            return true;
        }

    </script>
</head>
<body>
    <div class="container">
        <div id="divmessage">
            @if (TempData["message"] != null)
            {@Html.Raw(TempData["message"].ToString())}

            @if (ViewBag.message != null)
            {@Html.Raw(ViewBag.message.ToString())}
        </div>


        <div class="header">
            <div class="header-logo">
                <div class="logo-container">
                    <!-- Temple Icon SVG -->
                    <img src="Content/User/images/favicon.png" style="width: 40px;" alt="@objAppInfo.SiteName" title="@objAppInfo.SiteName" />
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 0.9rem;">@objAppInfo.SiteName</div>
                    <div style="font-size: 0.75rem; opacity: 0.8;">Individual Ticket</div>
                </div>
            </div>

            <div class="header-content">
                <div class="ticket-badge">Individual Ticket</div>
                <h1>Ticket Check-In</h1>
                <p>Scan-based Individual Ticket Management</p>
            </div>
            @if (this.User.Identity.IsAuthenticated && this.User.Identity.Name != null && Context.Session != null && Context.Session.GetString("username") != null)
            {
                if (objEventRegTickets.Status == "Yes")
                {

                    
                }
                else
                {
        <div class="header-actions">
            <button class="login-btn">Check-In</button>
        </div>
                }
                
            }
            else
            {
                <div class="header-actions">
                    <button class="login-btn" onclick="openLoginModal()">Login</button>
                </div>
            }
        </div>

        @*<div class="header">
                <div class="header-content">
                    <div class="ticket-badge">Individual Ticket</div>
                    <h1>Ticket Check-In</h1>
                    <p>Scan-based Individual Ticket Management</p>
                </div>
            </div>*@

    <div class="content">
        <!-- Back Navigation -->
        @*<a href="#" class="back-link">
            ← Back to Registration Overview
        </a>*@

        <!-- Individual Ticket Overview -->
        <div class="ticket-overview">
            <div class="ticket-header">
                <label class="ticket-label">Ticket Number :</label>
                <div class="ticket-id-display">@objEventRegTickets.TicketId</div>
                <label class="ticket-label pn">Check-In :</label>
                <div class="ticket-status-large status-pending">@(objEventRegTickets.Status != null && objEventRegTickets.Status != "" ? objEventRegTickets.Status : "Pending")</div>
            </div>





            <div class="ticket-details-grid">
                <div class="detail-item">
                    <div class="detail-label">Registration Type</div>
                    <div class="detail-value">@objEventRegTickets.RegistrationTitle Ticket @objEventRegTickets.SequenceNo</div>
                </div>
                @*<div class="detail-item">
                    <div class="detail-label">Sequence Number</div>
                    <div class="detail-value">003</div>
                </div>*@
                <div class="detail-item">
                    <div class="detail-label">Amount</div>
                    <div class="detail-value">$@objEventRegTickets.PaidAmount</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Purchase Date</div>
                    @*<div class="detail-value">@objEventRegTickets.UpdatedTime</div>*@


                    <div class="info-value">
                        @TimeZoneInfo.ConvertTimeFromUtc(
                            objEventRegTickets.UpdatedTime.Value,
                            TimeZoneInfo.FindSystemTimeZoneById("Central Standard Time")
                        )
                    </div>
                </div>
            </div>

            @if (objEventRegTickets.Status != "Yes")
            {
                    if (this.User.Identity.IsAuthenticated && this.User.Identity.Name != null && Context.Session != null && Context.Session.GetString("username") != null)
                    {
                    using (Html.BeginForm("InsertEventCheckIn", "Event", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <input id="EventUserInfoId" name="EventUserInfoId" type="hidden" value="@objEventRegTickets.EventUserInfoId" />
                        <input id="EventId" name="EventId" type="hidden" value="@objEventRegTickets.EventId" />
                        <input id="EventRegTicketId" name="EventRegTicketId" type="hidden" value="@objEventRegTickets.EventRegTicketId" />
                        <input id="uid" name="uid" value="@uid" type="hidden" />

                        @*<div class="section-title">Individual Ticket Check-In</div>*@

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                            <div class="form-group">
                                <label class="form-label">Check-In Status *</label>
                                <select class="form-select" id="Status" name="Status" required>
                                    <option value="">Select Status</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>

                        </div>

                        <div class="form-group">
                            <label class="form-label">Comments </label>
                            <textarea class="form-textarea" id="Comments" name="Comments" placeholder="Enter your comments here..."></textarea>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" style="border-radius: 0px; padding: 10px 20px;">Update</button>
                            @*<button type="button" class="btn btn-secondary" onclick="resetForm()">Reset Form</button>
                            <a href="#" class="btn btn-success" style="text-decoration: none;">View All Tickets</a>*@
                        </div>
                    }
                }
                else
                {
                    <!-- Login Note for Non-authenticated Users -->
                    <div class="login-note">
                        <strong>Note:</strong> Do you have login? If yes,
                        <a href="#" class="login-link" onclick="openLoginModal()">click here</a> to submit details.
                    </div>
                }
            }
            else if (objEventRegTickets.Status == "Yes")
            {
                <div class="form-section" style="margin-top:20px">
                    <div class="event-details"><h4>Check-In Completed</h4></div>
                    <p style="color:green;font-weight:bold;">This ticket for this registration are already checked in.</p>
                </div>
            }
            else
            {
                <div class="login-note">
                    <strong>Note:</strong> Do you have login? If yes,
                    <a href="#" class="login-link" onclick="openLoginModal()">click here</a> to submit details.
                </div>
            }

        </div>

        <!-- Registrant Details -->
        <div class="section">
            <div class="section-title">Registrant Information</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Full Name</div>
                    <div class="info-value">@objEventRegTickets.FirstName @objEventRegTickets.LastName</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value">@objEventRegTickets.Email</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Mobile</div>
                    <div class="info-value">@objEventRegTickets.PhoneNo</div>
                </div>

            </div>
        </div>

        <!-- Current Check-in Status -->
