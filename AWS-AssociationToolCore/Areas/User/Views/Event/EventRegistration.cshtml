<script>

    var squareCard = null;
    var SQUARE_APP_ID = "@objPaymentSettings.PaymentUrl";
    var SQUARE_LOCATION_ID = "@objPaymentSettings.TokenNo";
    var SQUARE_ENV = "@objPaymentSettings.AccountType";
    var squarePrePaymentDone = false;
    var squarePrePaymentInProgress = false;

    function resetSquareState() {
        squareCard = null;
        squarePrePaymentDone = false;
        squarePrePaymentInProgress = false;
        var btnProceed = document.getElementById("btnProceedPay");
        if (btnProceed) {
            btnProceed.style.display = "inline-block";
            btnProceed.disabled = false;
            btnProceed.innerText = "Proceed to Pay";
        }
        var cardBtn = document.getElementById("card-button");
        if (cardBtn) cardBtn.style.display = "none";
        var container = document.getElementById("card-container");
        if (container) container.innerHTML = "";
    }

    async function initializeSquareCard() {
        if (squareCard) return;
        if (typeof Square === "undefined") {
            var scriptUrl = SQUARE_ENV === "Test"
                ? "https://sandbox.web.squarecdn.com/v1/square.js"
                : "https://web.squarecdn.com/v1/square.js";
            await loadScript(scriptUrl);
        }
        var payments = Square.payments(SQUARE_APP_ID, SQUARE_LOCATION_ID);
        squareCard = await payments.card();
        await squareCard.attach("#card-container");
    }


        function loadScript(src) {
        return new Promise(function (resolve, reject) {
            if (document.querySelector("script[src='" + src + "']")) { resolve(); return; }
            var s = document.createElement("script");
            s.src = src;
            s.onload = resolve;
            s.onerror = reject;
            document.head.appendChild(s);
        });
    }

    // ── Move ALL event listeners inside document.ready ──
    $(document).ready(function () {


          $(document).on("click", ".cus-tab-label", function () {
            var clickedTab = $(this).data("tab");
            if ($("#PaymentMethod").val() === "Square" && clickedTab !== "tabsquare") { resetSquareState(); }
        });

        // ── Proceed to Pay button ──
        $("#btnProceedPay").on("click", async function () {

            var paymentMethod = $("#PaymentMethod").val();
            if (paymentMethod !== "Square") return;

            // ── Validation runs FIRST ──
            if (!$("#SignupForm").valid()) {
                $("#SignupForm").validate().form();
                // Scroll to first error
                $('html, body').animate({
                    scrollTop: $("em.help-block:first").offset().top - 100
                }, 500);
                return;
            }

            // ── Amount check ──
            var amount = $("#AmountPaid").val();
            if (!amount || parseFloat(amount) <= 0) {
                alert("⚠️ Please enter a donation amount.");
                return;
            }

            var btn = document.getElementById("btnProceedPay");

            if (squarePrePaymentDone) {
                btn.style.display = "none";
                document.getElementById("card-button").style.display = "inline-block";
                return;
            }

            if (squarePrePaymentInProgress) return;

            squarePrePaymentInProgress = true;
            btn.disabled = true;
            btn.innerText = "Loading payment form...";

            try {
                await initializeSquareCard();
                squarePrePaymentDone = true;
                document.getElementById("card-button").style.display = "inline-block";
                btn.style.display = "none";
            } catch (err) {
                btn.disabled = false;
                btn.innerText = "Proceed to Pay";
                squarePrePaymentInProgress = false;
                alert("❌ Error loading payment form: " + (err.message || "Unexpected error."));
                console.error("Square init error:", err);
            }
        });

        // ── Pay button ──
        $("#card-button").on("click", async function () {
            if (!squareCard) { alert("Card form not ready. Please try again."); return; }

            var btn = this;
            btn.disabled = true;
            btn.innerText = "Processing...";

            try {
                var result = await squareCard.tokenize();
                if (result.status === "OK") {
                    $("#SquareNonce").val(result.token);
                    btn.innerText = "Processing payment...";
                    document.getElementById("SignupForm").submit();
                } else {
                    btn.disabled = false;
                    btn.innerText = "Pay";
                    var errors = result.errors
                        ? result.errors.map(function (e) { return e.message; }).join(", ")
                        : "Unknown error";
                    alert("⚠️ Card error: " + errors);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerText = "Pay";
                alert("❌ Error processing payment: " + (err.message || "Unexpected error"));
            }
        });

    }); // end document.ready


</script>

<script type="text/javascript">

        var actionStatus = null;
        var cnameValue   = '@cname';

        $(document).ready(function () {
            $("#hiden2").hide();
            $("#PromoCode").val('');
            $("#PromoCodeNew").val('');
            $("#SACPromoCodeNew").val('');
            formload();
            if (@amount == 0) {
                $('#paypal-button-container').hide();
                $('#paypal-show').hide();
                $('#button-show').show();
            }
        });

        $(document).ready(function () {
            window.onpageshow = function (event) {
                if (event.persisted || performance.getEntriesByType("navigation")[0].type === 'back_forward') {
                    location.reload();
                }
            };
        });

        // ================================================================
        // PHONE FORMATTING
        // ================================================================
        function formatPhoneNumber(number) {
            const cleaned = number.replace(/\D/g, "");
            if (cleaned.length < 10) return cleaned;
            if (cleaned.length > 10) return cleaned.slice(0, 10);
            return cleaned.slice(0,3) + '-' + cleaned.slice(3,6) + '-' + cleaned.slice(6);
        }
        const phoneNumber = document.getElementById("phoneNumber");
        if (phoneNumber) {
            phoneNumber.addEventListener("input", function () {
                this.value = formatPhoneNumber(this.value);
            });
        }
        function handlePaste(event) {
            if (event.target.id === "Mobile") {
                const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
                event.target.value = formatPhoneNumber(pastedNumber);
                event.preventDefault();
            }
        }

        // ================================================================
        // VALIDATE
        // ================================================================
        function Validate(id, stype, count) {
            var return_val = true;

            if ('@objEvents.EventCategory' == "Cultural with Competition") {
                if ($.trim($('#ItemCategory').val()) == '') {
                    $('#ItemCategory').focus().addClass('validate');
                    $('#spanItemCategory').html('Competition Category Required'); return_val = false;
                } else { $('#spanItemCategory').html(''); $('#ItemCategory').removeClass('validate'); }

                if ($.trim($('#ItemName').val()) == '') {
                    $('#ItemName').focus().addClass('validate');
                    $('#spanItemName').html('No of Participants Required'); return_val = false;
                } else { $('#spanItemName').html(''); $('#ItemName').removeClass('validate'); }
            }

            var validval = 1;
            for (var v = 1; v <= @lstEventRegistrationTypes.Count; v++) {
                if ($('#people' + v).val() == '' && validval == 1) { validval = 1; }
                else { validval = 0; }
            }
            if (validval == 1 && id == 1) {
                if (@lstEventRegistrationTypes.Count > 0) {
                    alert("Please select at least one Registration Category.");
                    return_val = false;
                }
            }
            return return_val;
        }

        function RegValidate(plist, count, ecount, regcount) {
            if (ecount != 0) { count = count - ecount; }
            var return_val = true;
            for (var j = 1; j <= @lstEventRegistrationTypes.Count; j++) {
                if ('@Memberdetails.MemberId' != "0") {
                    if (j == plist) {
                        if ($('#people' + j).val() > count) {
                            $('#people' + j).val('');
                            alert('Limit of ' + count + ' tickets per member ID.');
                            $('#people' + j).focus().addClass("validate"); return_val = false;
                        } else { $('#people' + j).removeClass("validate"); }
                    }
                } else {
                    if ($('#people' + j).val() > count) {
                        $('#people' + j).val('');
                        alert('Limit of ' + count + ' tickets per member ID.');
                        $('#people' + j).focus().addClass("validate"); return_val = false;
                    } else { $('#people' + j).removeClass("validate"); }
                }
            }
            return return_val;
        }

        function formload() {
            if ('@objEvents.PageTitle' == 'No') {
                $('#formshow').show();
                $('#formhide').hide();
            }
        }

        // ================================================================
        // CALCULATE TOTAL
        // ================================================================
        function calculate_total(plist, count, ecount, regcount, RegistrationTitle) {
            if (RegValidate(plist, count, ecount, regcount)) {
                document.getElementById("amount" + plist).innerHTML = "$" + ($('#hamount' + plist).val() * $('#people' + plist).val());

                var total5 = 0;
                for (var i = 1; i <= @lstEventRegistrationTypes.Count; i++) {
                    var p = parseInt(document.getElementById('people' + i).value);
                    if (p > 0) { total5 = total5 + (p * parseFloat($('#hamount' + i).val())); }
                }
                total5 = parseFloat(total5).toFixed(2);

                var discountAmount1 = 0;
                if (plist != 0) {
                    $('#DiscountPercent').val(0);
                    $(".grandtotal").html('0');
                    $(".TotalDiscount").html('0');
                    $("#PromoCode").val('');
                    $("#PromoCodeNew").val('');
                    $("#SACPromoCodeNew").val('');
                    $("#divReset").hide();
                    $('#DiscountText2').hide();
                    $("#divApply").show();
                    $("#divDiscount").hide();
                    $('#DiscountAmount').val(0);
                }

                var DiscountPercent = $('#DiscountPercent').val();
                if (DiscountPercent > 0) { discountAmount1 = total5 * DiscountPercent / 100; }

                $("#TotalDiscount").html("$" + discountAmount1.toFixed(0));
                var grandtotal = total5 - discountAmount1;
                $('#DiscountAmount').val(discountAmount1.toFixed(0));

                $('.totalamountzelle').html(grandtotal.toFixed(2));
                $('#AmountPaid').val(grandtotal.toFixed(2));
                $('#payamount').val(grandtotal.toFixed(2));
                $('#creditamount').html(grandtotal.toFixed(2));
                $('#totalamountcash').html(grandtotal.toFixed(2));
                $('.grandtotal').html(grandtotal.toFixed(2));

                $('#RegistrationTitle').val("Event Registration###" + grandtotal.toFixed(2));

                // Fire amount-updated so Braintree partial re-inits
                var newAmt = parseFloat($('#AmountPaid').val());
                if (newAmt > 0) { $(document).trigger("amount-updated"); }
            }
        }



        var specialKeys = [8, 9, 32, 46, 36, 35, 37, 39];

        function onlyAlphabets(e, t) {
            try {
                var charCode = window.event ? window.event.keyCode : (e ? e.which : 0);
                if (!charCode) return true;
                if ((charCode == 32) || (charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) ||
                    (specialKeys.indexOf(e.keyCode) != -1 && e.charCode != e.keyCode)) return true;
                else return false;
            } catch (err) { alert(err.Description); }
        }

        function phonenochange(event) {
            if (event.keyCode != 8 && event.keyCode != 46) {
                var ph = $('#Mobile').val();
                if (ph.length == 3) { $('#Mobile').val(ph + '-'); }
                if (ph.length == 7) { $('#Mobile').val(ph + '-'); }
            }
        }

     function paymentbind(type) {
        console.log('paymentbind:', type);

        // ── STEP 0: Teardown Braintree when leaving Credit Card ──
        if (type !== "Credit Card" && window.dropinInst) {
            try {
                window.dropinInst.teardown(function () {
                    window.dropinInst = null;
                    console.log('Braintree torn down');
                });
            } catch (e) {
                window.dropinInst = null;
            }
            // Clear the container so iframe is removed
            $('#tabcredit-card').empty();
            // Reload Braintree partial fresh for next time
            $.ajax({
                type: "GET",
                url: '@Url.Action("BrainTree", "BrainTreePayment", new { area = "User" })',
                success: function (data) {
                    $("#tabcredit-card").html(data);
                }
            });
        }

        // ── STEP 1: Reset validator ignore ──
        var validator = $('#SignupForm').data('validator');
        if (validator) {
            validator.settings.ignore = ':hidden:not(#recaptchaResponse)';
        }

        // ── STEP 2: Hide ALL buttons first ──
        $('#paypal-button-container').hide();
        $('#paypal-show').hide();
        $('#button-show').hide();
        $('#submit-button').hide();
        $('#btnProceedPay').hide();
        $('#card-button').hide();

        // ── STEP 3: Show correct buttons ──
        if (type === "PayPal") {
            $('#paypal-button-container').show();
            $('#paypal-show').show();

        } else if (type === "Square") {
             $('#paypalbuttonshow').hide();
                $('#paypal-button-container').hide();
                $('#paypal-show').hide();
                $('#button-show').hide();
                $('#submit-button').hide();
                $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
                $('#card-button').hide();
                $('#square-timer-display').hide();

        } else if (type === "Credit Card") {
            var amt = parseFloat($('#AmountPaid').val());
            if (!amt || isNaN(amt) || amt <= 0) {
                alert("Please select at least one ticket before using Credit Card.");
                var firstMethod = '@firstPaymentMethod';
                paymentbind(firstMethod === 'Credit Card' ? 'PayPal' : firstMethod);
                return;
            }
            $('#button-show').show();
            $('#submit-button').show();

            // ── Init Braintree ──
            function tryInitBT() {
                if (typeof window.startBraintree === "function") {
                    if (!window.dropinInst) { window.startBraintree(); }
                } else { setTimeout(tryInitBT, 300); }
            }
            tryInitBT();

        } else {
            // Cash/Cheque, Zelle, Stripe, SwirePay
            $('#button-show').show();
            $('#submit-button').show();
        }

        // ── STEP 4: Set hidden payment method ──
        $('#PaymentMethod').val(type);

        // ── STEP 5: Remove ALL rules, add rules for current type ──
        if (validator) {
            $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
            $("#file2").rules("remove");
            $("#ChequeHolderName").rules("remove");

            $('#Mailed-1').prop('checked', true);
            $('#cheque-show').show();
            $('.cheque-hide').hide();

            if (type === "Zelle") {
                $("#ZellePartnerName").rules("add", { required: true });
                $("#Zelle").rules("add", { required: true });
                $("#filezelle").rules("add", {
                    required: true,
                    validImageExtension: true
                });
            } else if (type === "Cash/Cheque") {
                $("#file2").rules("add", {
                    required: true,
                    validImageExtension: true
                });
                validator.settings.ignore = ':hidden:not(#file2)';
            }

            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // ── STEP 6: Activate correct tab panel ──
        var cleanedTabId = "tab" + type.toLowerCase()
            .replace(/[^a-z0-9\s]/g, '')
            .trim()
            .replace(/\s+/g, '-');

        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();

        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');
    }
