@using Microsoft.AspNetCore.Http
@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";
    var objEvents = (AWS_AssociationToolCore.Entities.Events)ViewBag.objEvents;
    var Memberdetails = (AWS_AssociationToolCore.Entities.Members)ViewBag.Memberdetails;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.BLL.PaymentSettings _paymentSettings = new AWS_AssociationToolCore.BLL.PaymentSettings();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    int status = 0;
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    List<AWS_AssociationToolCore.Entities.EventRegistrationTypes> lstEventRegistrationTypes = ViewBag.lstEventRegistrationTypes;
    List<AWS_AssociationToolCore.Entities.EventCompetitions> lstEventCompetitions = ViewBag.lstEventCompetitions;
    var lstPaymentMethod = (List<AWS_AssociationToolCore.Entities.PaymentMethods>)ViewBag.lstpaymentmethods;

    decimal amount = 0;
    string cname = ViewBag.cname;
    decimal Total = 0;
    int status2 = 0;
    var capcha = objAppInfo.ShowCapcha;
    AWS_AssociationToolCore.Entities.PaymentSettings objPaymentSettings = _paymentSettings.GetPaymentSettingsDetails(0, "Square", ref status2);

    ViewBag.Title = "Event Registration | " + AWS_AssociationToolCore.BLL.Common.DecodeURL(ViewBag.EventName) + " - " + objAppInfo.SiteName;
    ViewBag.MetaDescription = "Register for upcoming Telugu cultural and community events.";
    ViewBag.MetaKeywords = "Telugu event registration, cultural event signup";
    ViewBag.PageHeading = "Registration For " + AWS_AssociationToolCore.BLL.Common.DecodeURL(ViewBag.EventName);

    string firstPaymentMethod = (lstPaymentMethod != null && lstPaymentMethod.Count > 0)
        ? lstPaymentMethod[0].PaymentMethod : "Square";
}

<script src="https://www.paypal.com/sdk/js?client-id=@objPaymentSettings.PaymentUrl&components=buttons"></script>
