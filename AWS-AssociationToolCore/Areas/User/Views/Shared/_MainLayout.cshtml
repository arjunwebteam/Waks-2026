        @@media (min-width: 1024px) {
            .navbar

        {
            padding: 0;
            width: 100%;
        }

        .navbar ul {
            margin: 0;
            padding: 0;
            display: flex;
            list-style: none;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
        }

        .navbar > ul {
            width: 100%;
        }

        .navbar li {
            position: relative;
        }

        .navbar > ul > li {
            white-space: nowrap;
        }

            .navbar > ul > li.login-n {
                margin-left: auto;
            }

        .navbar a, .navbar a:focus {
            display: flex;
            align-items: center;
            justify-content: space-between;
            white-space: nowrap;
            transition: 0.3s;
            position: relative;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--white-color);
            font-family: 'Poppins-Medium';
            padding: 13px 10px;
            border-radius: 0px;
            line-height: 100%;
            letter-spacing: 0px;
        }

            .navbar a i,
            .navbar a:focus i {
                font-size: 12px;
                line-height: 0;
                margin-left: 5px;
                position: relative;
                z-index: 20;
            }

            .navbar a:hover,
            .navbar li.active > a,
            .navbar li:hover a, .menu-active a {
                color: #fff600;
                background: linear-gradient(#f94d00, #fe8626);
            }

        /* Desktop dropdown - override inline display:none with !important */
        .navbar .menu-item-has-children ul {
            display: block !important; /* This overrides inline style="display:none" */
            position: absolute;
            left: 0px;
            top: calc(100% + 30px);
            margin: 0;
            padding: 0;
            z-index: 99;
            opacity: 0;
            visibility: hidden;
            background: var(--white-color);
            box-shadow: 0px 0px 30px rgba(127, 137, 161, 0.25);
            transition: 0.3s ease;
            min-width: 200px;
            pointer-events: none;
        }

        /* Show on hover */
        .navbar .menu-item-has-children:hover > ul {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            top: 100%;
        }

        .navbar .menu-item-has-children ul a {
            padding: 10px 20px;
            text-transform: none;
            color: #000;
            background: var(--white-color);
            display: block;
            white-space: nowrap;
        }

            .navbar .menu-item-has-children ul a i {
                font-size: 12px;
            }

            .navbar .menu-item-has-children ul a:hover,
            .navbar .menu-item-has-children ul .active:hover,
            .navbar .menu-item-has-children ul li:hover > a {
                color: var(--white-color);
                background-color: #ff9037;
                border-radius: 0;
            }

        /* Sub-sub menu */
        .navbar .menu-item-has-children .menu-item-has-children ul {
            top: 0;
            left: calc(100% - 30px);
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .navbar .menu-item-has-children .menu-item-has-children:hover > ul {
            opacity: 1;
            top: 0;
            left: 100%;
            visibility: visible;
            pointer-events: auto;
        }

        .mobile-nav-show,
        .mobile-nav-hide {
            display: none !important;
        }

        .aws-app-menu {
            display: none !important;
        }

        }

