    <!-- ═════════ Reset Password Modal ═════════ -->
    <div class="modal fade aws-modal" id="resetPwdModal" data-bs-backdrop="static" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="aws-title2 mb-3">Reset Password</div>

                <!-- Expired message -->
                <div id="rpExpired" style="display:none; text-align:center !important; padding:10px 15px 20px;">
                    <i class="bi bi-exclamation-circle"
                       style="font-size:42px; color:#dc3545; display:block; margin-bottom:10px;"></i>
                    <p style="margin:0 0 18px; color:#dc3545; font-size:15px; line-height:1.6; text-align:center !important;">
                        Password link expired.<br />
                        Please try again from the Forgot Password page.
                    </p>
                    <a href="reset-password" class="aws-btn3"> Click Here </a>
                </div>

                <!-- Reset form -->
                <form id="resetPwdForm" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" id="rpToken" />
                    <p style="font-size:13px;">Email: <b id="rpEmail"></b></p>

                    <div class="aws-alert-info mb-3" style="font-size:12px;">
                        Minimum 8 characters (at least one special character &amp; one numeric character)
                    </div>

                    <fieldset class="toggle-password">
                        <legend class="float-none w-auto px-1">New Password <span class="input-imp">*</span></legend>
                        <input class="input-box" type="password" id="rpNew" name="NewPassword" placeholder="New Password*">
                        <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('rpNew', this)"></i>
                    </fieldset>

                    <fieldset class="toggle-password">
                        <legend class="float-none w-auto px-1">Retype Password <span class="input-imp">*</span></legend>
                        <input class="input-box" type="password" id="rpConf" name="ConfPassword1" placeholder="Retype Password*">
                        <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('rpConf', this)"></i>
                    </fieldset>

                    <div id="rpMsg" class="my-2" style="font-size:13px;"></div>
                    <div class="text-end"><button type="submit" class="aws-btn3">Submit</button></div>
                </form>
            </div>
        </div>
    </div>

    <script>
        $(function () {
          var rp = new URLSearchParams(window.location.search).get('rp');
          if (!rp) return;   // లింక్ లో rp లేకపోతే ఏమీ చేయదు

          $.get('@Url.Action("CheckResetToken", "Members", new { area = "User" })', { token: rp })
            .done(function (r) {
              if (r.ok) {
                $('#rpToken').val(rp);
                $('#rpEmail').text(r.email);
                $('#resetPwdForm').show();
              } else {
                $('#rpExpired').show();
              }
              $('#resetPwdModal').modal('show');
            });

          $('#resetPwdForm').on('submit', function (e) {
            e.preventDefault();
            $('#rpMsg').text('');
            $.post('@Url.Action("ResetPasswordSubmit", "Members", new { area = "User" })', $(this).serialize())
              .done(function (res) {
                $('#rpMsg').css('color', res.ok ? 'green' : 'red').text(res.message);
                if (res.ok) {
                  setTimeout(function () {
                    location.href = '@Url.Action("LogOn", "Members", new { area = "User" })';
                  }, 1500);
                }
              })
              .fail(function () { $('#rpMsg').css('color', 'red').text('Failed Transaction.'); });
          });
        });
    </script>
