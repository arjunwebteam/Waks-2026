                                   class="btn-outline">View Details</a>
                            </div>

                            <div class="events_btns">
                            </div>
                        }
                    </div>
                </div>

                <div class="poster">
                    <img width="100px"
                         title="@item.EventName"
                         alt="@item.EventName"
                         src="@(AWS_AssociationToolCore.BLL.Common.ValidateImage(imglocNormal + item.Flyer, imglocNormal + " flyer-no2.jpg"))"
