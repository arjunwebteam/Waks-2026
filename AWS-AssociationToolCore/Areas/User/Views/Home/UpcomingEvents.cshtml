                                        {
                                            <a class="btn-gold" href="cultural-registration?EventName=@item.EventName&amp;EventId=@item.EventId&amp;cname=@chapterName">
                                                <span><span></span></span> Cultural Registration
                                            </a>
                                        }
                                        else
                                        {
                                            string eurl = "EventName=" + AWS_AssociationToolCore.BLL.Common.EncodeURL(@item.EventName) + "&eid=" + item.EventId + "&cname=" + chapterName;

                                            <a class="btn-gold" href="@Url.Action("LogOn", "Members", new { area = "User", url = eurl })">
                                                <span><span></span></span> Cultural Registration
                                            </a>
                                        }
