    <script>
        $(document).ready(function () {
            LoadBannersList();
            LoadLatestNewsList();
            LoadUpcomingEventsList();
        });

        function LoadBannersList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("Banners", "Home")',
                success: function (data) {
                    $("#divBannersList").html(data);
                },
                error: function () {
                    $("#divBannersList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }

        function LoadLatestNewsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("LatestNews", "Home")',
                success: function (data) {
                    $("#divLatestNewsList").html(data);
                },
                error: function () {
                    $("#divLatestNewsList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }

        function LoadUpcomingEventsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("UpcomingEvents", "Home")',
                success: function (data) {
                    $("#divUpcomingEventsList").html(data);
                },
                error: function () {
                    $("#divUpcomingEventsList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
    </script>


