          $(document).ready(function () {

            $('.menu-item-has-children > a').click(function (e) {

                if ($(window).width() <= 991) {

                    e.preventDefault();

                    var submenu = $(this).next('.sub-menu');

                    // Open ayithe close avuthundi, close ayithe open avuthundi

                    submenu.slideToggle(300);

