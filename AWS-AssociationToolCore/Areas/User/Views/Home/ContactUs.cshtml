<script>
     function PhoneNochange(event) {

        if (event.keyCode == 8 || event.keyCode == 46) {
            return;
        }

        var ph = $('#PhoneNo').val().replace(/\D/g, '');

        if (ph.length > 7) {
            $('#PhoneNo').val(
                ph.substring(0, 4) + ' ' +
                ph.substring(4, 7) + ' ' +
                ph.substring(7, 10)
            );
        }
        else if (ph.length > 4) {
            $('#PhoneNo').val(
                ph.substring(0, 4) + ' ' +
                ph.substring(4)
            );
        }
        else {
            $('#PhoneNo').val(ph);
        }
    }
    $(document).ready(function () {

        // Format Australian mobile number: 0421 151 439
        function formatPhone(value) {

            var phone = value.replace(/\D/g, '');

            // Limit to 10 digits
            phone = phone.substring(0, 10);

            if (phone.length > 7) {
                return phone.substring(0, 4) + " " +
                       phone.substring(4, 7) + " " +
                       phone.substring(7, 10);
            }

            if (phone.length > 4) {
                return phone.substring(0, 4) + " " +
                       phone.substring(4);
            }

            return phone;
        }

        // Format while typing
        $("#PhoneNo").on("input", function () {
            $(this).val(formatPhone($(this).val()));
        });
    $.validator.addMethod("phoneFormat", function (value, element) {

        console.log("Original:", value);

        var phone = value.replace(/\D/g, '');

        console.log("Digits:", phone);

        return this.optional(element) || /^0[234789]\d{8}$/.test(phone);

    }, "Please enter a valid Australian phone number");

        // Email Validation
        $.validator.addMethod("validate_email", function (value, element) {
            return this.optional(element) ||
                /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value);
        }, "Please enter valid email address");

        // Form Validation
        $("#ContactForm").validate({

            rules: {
                Name: {
                    required: true
                },
                Email: {
                    required: true,
                    validate_email: true
                },
                PhoneNo: {
        required: true,
        phoneFormat: true
    },
                Description: {
                    required: true
                },
                recaptcha: {
                    required: function () {
                        var capcha = '@capcha';
                        return capcha === "Yes" &&
                            $("#recaptchaResponse").val().trim() === "";
                    }
                }
            },

            messages: {

                Name: "Please enter your first name",

                Email: {
                    required: "Please enter your email address",
                    validate_email: "Please enter valid email address"
                },

  PhoneNo: {
    required: "Please enter mobile number",
    phoneFormat: "Please enter a valid Australian phone number"
},

                Description: "Please enter your comments",

                recaptcha: {
                    required: "Please confirm that you are not a robot."
                }
            },

            errorElement: "em",

            errorPlacement: function (error, element) {

                error.addClass("help-block");

                if (element.attr("name") == "recaptcha") {
                    error.insertAfter(".g-recaptcha");
                }
                else {
                    error.insertAfter(element);
                }
            },

            highlight: function (element) {
                $(element).parents("fieldset")
                    .addClass("has-error")
                    .removeClass("has-success");
            },

            unhighlight: function (element) {
                $(element).parents("fieldset")
                    .removeClass("has-error")
                    .addClass("has-success");
            }

        });

    });

    function onRecaptchaSuccess(token) {
        $("#recaptchaResponse").val(token);
        $("#recaptchaResponse").valid();
    }
</script>


