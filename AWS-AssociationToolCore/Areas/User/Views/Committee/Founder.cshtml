<style>
    #RenewalAlert {
        background-color: #000000a1;
    }

    /* ===== COMMITTEE POPUP STYLES ===== */
    .committee-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
