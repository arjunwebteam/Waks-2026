    }

        .popup-top::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 30px;
            background: #fff;
            border-radius: 50% 50% 0 0 / 30px 30px 0 0;
        }

    .popup-close {
        position: absolute;
