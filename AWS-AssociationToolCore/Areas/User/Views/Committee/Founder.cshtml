        cursor: pointer;
        font-size: 18px;
        color: #fff;
        z-index: 10;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

        .popup-close:hover {
            background: rgba(255,255,255,0.35);
        }

    .popup-avatar-wrap {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 4px solid #fff;
        overflow: hidden;
        margin: -55px auto 14px;
        background: #f0f0f0;
        position: relative;
        z-index: 2;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

        .popup-avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .popup-body {
        padding: 0 2rem 2rem;
    }

    .popup-name {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }

    .popup-divider {
        width: 50px;
        height: 3px;
        background: linear-gradient(90deg, #8b0000, #c0392b);
        margin: 0 auto 14px;
        border-radius: 2px;
    }

    .popup-desig {
        font-size: 14px;
        color: #888;
        background: #f8f8f8;
        border-radius: 20px;
        padding: 6px 18px;
        display: inline-block;
        margin-bottom: 6px;
    }

    /* ===== EYE BUTTON ===== */
    .eye-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #e53935;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 17px;
    }

        .eye-btn:hover {
            background: #c62828;
        }

    .popup-desc {
        text-align: center !important;
        color: black !important;
        font-size: 15px !important;
    }
</style>
<!-- ===== COMMITTEE POPUP HTML ===== -->
<!-- ===== COMMITTEE POPUP SCRIPT ===== -->
<script>

    // Store share data globally
    var _shareText = '';
    var _shareUrl  = '';

    function openCommitteePopupFromBtn(btn) {
        var name  = btn.getAttribute('data-name');
        var desig = btn.getAttribute('data-desig');
        var desc  = btn.getAttribute('data-desc');
        var img   = btn.getAttribute('data-img');
        openCommitteePopup(name, desig, desc, img);
    }

    function openCommitteePopup(name, desig, desc, img) {
        document.getElementById('popupName').textContent  = name;
        document.getElementById('popupDesig').textContent = desig;
        document.getElementById('popupImg').src           = img;

        var descEl = document.getElementById('popupDesc');
        if (descEl) descEl.innerHTML = desc;

        // Save for share handlers
        _shareUrl  = encodeURIComponent(window.location.href);
        _shareText = encodeURIComponent(name + ' - ' + desig);

        var el = document.getElementById('committeePopup');
        el.style.display        = 'flex';
        el.style.position       = 'fixed';
        el.style.inset          = '0';
        el.style.background     = 'rgba(0,0,0,0.55)';
        el.style.zIndex         = '999999';
        el.style.alignItems     = 'center';
        el.style.justifyContent = 'center';
        el.style.padding        = '20px';
    }

    function closeCommitteePopup() {
        document.getElementById('committeePopup').style.display = 'none';
    }

    document.getElementById('committeePopup').addEventListener('click', function(e) {
        if (e.target === this) closeCommitteePopup();
    });

    // ===== SHARE HANDLERS =====

    function handleWhatsApp(e) {
        e.preventDefault();
        var url;
        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
            // Mobile: open WhatsApp app directly
            url = 'whatsapp://send?text=' + _shareText + '%20' + _shareUrl;
        } else {
            // Desktop: open WhatsApp Web
            url = 'https://web.whatsapp.com/send?text=' + _shareText + '%20' + _shareUrl;
        }
        window.open(url, '_blank');
    }

    function handleFacebook(e) {
        e.preventDefault();
        var url;
        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
            // Mobile: try Facebook app deep link, fallback to browser
            url = 'fb://share/?link=' + _shareUrl;
            var fallback = 'https://www.facebook.com/sharer/sharer.php?u=' + _shareUrl;
            var win = window.open(url, '_blank');
            // If app not installed, open browser after short delay
            setTimeout(function() {
                try {
                    if (!win || win.closed || typeof win.closed == 'undefined') {
                        window.open(fallback, '_blank');
                    }
                } catch(ex) {
                    window.open(fallback, '_blank');
                }
            }, 1500);
        } else {
            // Desktop: open Facebook sharer
            url = 'https://www.facebook.com/sharer/sharer.php?u=' + _shareUrl;
            window.open(url, '_blank', 'width=600,height=400');
        }
    }

    function handleTwitter(e) {
        e.preventDefault();
        var url;
        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
            // Mobile: try Twitter app deep link
            url = 'twitter://post?message=' + _shareText + '%20' + _shareUrl;
            var fallback = 'https://twitter.com/intent/tweet?text=' + _shareText + '&url=' + _shareUrl;
            var win = window.open(url, '_blank');
            setTimeout(function() {
                try {
                    if (!win || win.closed || typeof win.closed == 'undefined') {
                        window.open(fallback, '_blank');
                    }
                } catch(ex) {
                    window.open(fallback, '_blank');
                }
            }, 1500);
        } else {
            // Desktop: open Twitter web
            url = 'https://twitter.com/intent/tweet?text=' + _shareText + '&url=' + _shareUrl;
            window.open(url, '_blank', 'width=600,height=400');
        }
    }

    function handleGmail(e) {
        e.preventDefault();
        var url;
        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
            // Mobile: open Gmail app or default mail app
            url = 'googlegmail://co?subject=' + _shareText + '&body=' + _shareUrl;
            var fallback = 'mailto:?subject=' + _shareText + '&body=Check%20this%20out%3A%20' + _shareUrl;
            var win = window.open(url, '_blank');
            setTimeout(function() {
                try {
                    if (!win || win.closed || typeof win.closed == 'undefined') {
                        window.location.href = fallback;
                    }
                } catch(ex) {
                    window.location.href = fallback;
                }
            }, 1500);
        } else {
            // Desktop: open mailto (default mail client)
            window.location.href = 'mailto:?subject=' + _shareText + '&body=Check%20this%20out%3A%20' + _shareUrl;
        }
    }

</script>


