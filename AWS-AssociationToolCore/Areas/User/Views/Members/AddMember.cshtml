        // ================================================================
        // GET MEMBERSHIP AMOUNT
        // FIX: triggers "amount-updated" so Braintree partial re-inits
        // ================================================================
        function getamount(mid) {
            var membershipid = (mid != null && mid != 0) ? mid : $('input[name="MembershipTypeId"]:checked').val();
            $.ajax({
                url:      '@Url.Action("GetMemberAmount", "Members")',
                type:     'POST',
                data:     { MembershipTypeId: membershipid },
                dataType: 'json',
                success: function (result) {
                    if (typeof result === 'string') result = JSON.parse(result);
                    if (result.ok) {
                        var t = result.data;
                        $('#payamount,#totalamountzelle,#totalstripe,#totalswirepay,#creditamount,#totalamountcash').html(t.Price + '.00');
                        $('#MemberAmount').val(t.Price).trigger('input');
                        $('#creditamount').val(t.Price).trigger('input');
                        $('#MembershipType').val(t.MembershipType);
                        $('#MembershipType1').val(t.MembershipType + '###' + t.Price);

                        // FIX: fire amount-updated so Braintree partial re-inits
                        $(document).trigger("amount-updated");

                        if (actionStatus) { try { actionStatus.enable(); } catch (e) {} }
                    }
                }
            });
        }

        // ================================================================
        // PAYMENT SETTINGS (Zelle / Cash details)
        // ================================================================
        function paymentsettings(type) {
            $.ajax({
                url:      '@Url.Action("GetPayment", "Members")',
                type:     'POST',
                data:     { PaymentMethod: type },
                dataType: 'json',
                success: function (result) {
                    if (typeof result === 'string') result = JSON.parse(result);
                    if (result.ok) {
                        var s = result.data;
                        $('#PaymentUrl,#PaymentUrl1,#PaymentUrl2,#PaymentUrl3,#PaymentUrl4').html(s.PaymentUrl);
                        $('#SuccessUrl').html(s.SuccessUrl);
                    }
                }
            });
        }


    function paymentbind(type) {
        console.log('paymentbind called:', type);

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            validator.settings.ignore = ':hidden:not(#recaptchaResponse)';
        }

        // ── Teardown Braintree when switching away from Credit Card ──
        if (type !== "Credit Card" && window.dropinInst) {
            try {
                window.dropinInst.teardown(function () {
                    window.dropinInst = null;
                    console.log('Braintree torn down');
                });
            } catch (e) {}
            $('#dropin-container').hide().empty();
        }

        // ── Show/hide buttons based on payment type ──
        if (type === "PayPal") {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
            $('#submit-button').hide();
        } else if (type === "Square") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#proceedtopay1').hide();
            $('#proceedtopay').hide();
            $('#submitbtn').hide();
            $('#btnCashProceed').hide();
            $('#btnZelleProceed').hide();
            $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
            $('#card-button').hide();
            $('#hidebutton').hide();
            $('#square-timer-display').hide();
        } else if (type === "Credit Card") {
            $('#button-show').show();
            $('#submit-button').show();
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
        } else {
            $('#button-show').show();
            $('#submit-button').show();
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
        }

        $('#PaymentMethod').val(type);

        // ── Handle validation rules ──
        if (validator) {

            // ── Remove ALL conditional rules first (guarded against missing elements) ──
            if ($("#CardNumber").length) $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
            if ($("#Zelle").length) $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
            if ($("#file2").length) $("#file2").rules("remove");
            if ($("#ChequeHolderName").length) $("#ChequeHolderName").rules("remove");

            // ── Add rules based on selected payment type ──
            if (type === "AuthorizeNet") {
                $("#CardNumber").rules("add", { required: true });
                $("#CardName").rules("add",   { required: true });
                $("#Cvv").rules("add",        { required: true });
                $("#CSVYear").rules("add",    { required: true });
                $("#CSVMonth").rules("add",   { required: true });

            } else if (type === "Bank/Transfer") {
                paymentsettings(type);

                if ($("#file2").length) {
                    $("#file2").rules("add", {
                        required: true,
                        validImageExtension: true
                    });
                }

                validator.settings.ignore = ':hidden:not(#file2):not(#recaptchaResponse)';

            } else if (type === "Credit Card") {
                var amount = parseFloat($('#MemberAmount').val());
                if (!amount || isNaN(amount) || amount < 5) {
                    alert("Please select a membership type with a valid amount first.");
                    paymentbind('PayPal');
                    return;
                }
                $('#paypal-button-container').hide();
                $('#dropin-container').show();
                function tryInitBT() {
                    if (typeof window.startBraintree === "function") {
                        if (!window.dropinInst) { window.startBraintree(); }
                    } else {
                        setTimeout(tryInitBT, 200);
                    }
                }
                tryInitBT();

            } else if (type === "Zelle") {
                $("#Zelle").rules("add",            { required: true });
                $("#ZellePartnerName").rules("add",  { required: true });
                $("#filezelle").rules("add",         {
                    required: true,
                    validImageExtension: true
                });
            }

            // ── Clear all error states ──
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // ── Activate correct tab panel ──
        var cleanedTabId = "tab" + type.toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();

        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');
    }

