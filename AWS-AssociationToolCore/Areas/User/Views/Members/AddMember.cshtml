<script>
    $(document).ready(function () {

        // Phone formatting
        $('#MobilePhone, #SpouseCell').on('input', function () {
            $(this).val(formatPhone($(this).val()));
        });

        // Card number spacing
        $('#CardNumber').on('input', function () {
            var v = $(this).val().replace(/\D/g, '');
            if (v.length > 0) v = v.match(/.{1,4}/g).join(' ');
            $(this).val(v);
        });

        // CVV numbers only
        $('#Cvv').on('input', function () {
            $(this).val($(this).val().replace(/\D/g, ''));
        });

        // Load initial membership amount on page load
        getamount(null);

        // Custom image extension validator
        $.validator.addMethod('validImageExtension', function (value, element) {
            if (element.files && element.files.length > 0) {
                var ext = element.files[0].name.split('.').pop().toLowerCase();
                return ['jpg','png','gif','jpeg'].indexOf(ext) !== -1;
            }
            return true;
        }, 'Only allowed extensions are: jpg, png, gif, jpeg');
            // Australian phone number validator
    $.validator.addMethod('phoneFormat', function (value, element) {
        var phone = value.replace(/\D/g, '');
        return this.optional(element) || /^0[234789]\d{8}$/.test(phone);
    }, 'Please enter a valid  phone number');

        // ================================================================
        // FORM VALIDATION
        // ================================================================
        $('#SignupForm').validate({
            ignore: ':hidden:not(#recaptchaResponse)',
            onkeyup: function(element) {
                // Trigger validation on keyup for email field
                if ($(element).attr('name') === 'Email') {
                    this.element(element);
                }
            },
            onfocusout: function(element) {
                // Trigger validation when leaving any field
                this.element(element);
            },
            rules: {
                FirstName: { required: true },
                LastName:  { required: true },
                gender:  { required: true },
                MaritalStatus:  { required: true },
                Email: {
                    required: true,
                    email: true,
                    remote: {
                        type: 'POST',
                        url: '@Url.Action("CheckEmailAvailability", "Members")',
                        dataType: 'json',
                        data: { 
                            Email: function() { 
                                return $('#Email').val().trim(); 
                            } 
                        },
                        dataFilter: function(response) {
                            var r = JSON.parse(response);
                            return r.data === true ? 'true' : 'false';
                        }
                    }
                },
            
                MobilePhone:  { required: true, phoneFormat: true },
                  
                ZipCode:      { digits: true, minlength: 4, maxlength: 6 },
                Password:     { required: true },
                ConfPassword: { required: true, minlength: 5, equalTo: '#Password' },
                Address:      { required: true, minlength: 5 },
                file2:      { required: true, validImageExtension: true },
                filezelle:  { required: true, validImageExtension: true },
                State:        { required: true },
                    ItemValue:    { required: true },
                City:         { required: true },
                MembershipTypeId: { required: true },
                SpouseEmail:  { email: true },
                SpouseCell:   { phoneFormat: true },
                   
               
                recaptcha: {
                    required: function () {
                        var showCapcha = '@capcha';
                        return showCapcha === 'Yes' && $("#recaptchaResponse").val().trim() === "";
                    }
                }
            },
            messages: {
                FirstName:   'Please enter your First Name',
                LastName:    'Please enter your Last Name',
                MaritalStatus:    'Please Select Marital Status',
                gender:    'Please Select gender',
                Email: {
                    required: 'Please enter email address',
                    email:    'Please enter valid email address',
                    remote:   'This email address is already in use.'
                },
                 SpouseCell: {
        phoneFormat: 'Please enter a valid  phone number'
    },
    MobilePhone:  {
           required: 'Please enter phone number',
           phoneFormat: 'Please enter a valid  phone number'
       },                ZipCode:      { digits: 'Please enter only numeric characters', maxlength: 'ZipCode must be exactly 4 digits' },
                Password:     { required: 'Please provide a password' },
