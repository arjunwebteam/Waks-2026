@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";

    string cname = ViewBag.cname;
    string token = ViewBag.Token;
    bool tokenValid = ViewBag.TokenValid != null && (bool)ViewBag.TokenValid;

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    ViewBag.Title = "Reset Password | " + objAppInfo.SiteName + " Member Portal";
    ViewBag.PageHeading = "Reset Password";
    var Logon = objAppInfo.BaseUrl + "Content/Loginlogo/normalimages/";
}

<div class="aws-member-login-sec">
    <div class="row g-4">
        <div class="col-sm-5 d-flex justify-content-center align-items-center">
            <img src="@Logon/@objAppInfo.Loginlogo" alt="" class="img-fluid px-3" style="width:78%;" />
        </div>
        <div class="col-sm-7 d-flex align-items-center">
            <div class="px-lg-5 w-100">
                @if (tokenValid)
                {
                    <p style="font-family:'Poppins-Medium';">Please enter your new password in the popup.</p>
                    <a href="javascript:void(0)" class="aws-btn-bdr" onclick="$('#resetPasswordModal').modal('show');">Open Reset Password</a>
                }
                else
                {
                    <div class="aws-alert-info" style="background:#fff5f5;border-left:4px solid #cc0000;padding:14px 18px;border-radius:6px;">
                        <b style="color:#cc0000;">Password link expired.</b><br />
                        This reset link is no longer valid (links work for 30 minutes only, and only once).
                        Please request a new one from the Forgot Password page.
                    </div>
                    <div class="pt-3">
                        <a href="@Url.Action("ForgotPassword", "Members", new { cname = cname })" class="aws-btn-bdr">Forgot Password</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (tokenValid)
{
    <!-- Reset Password Modal -->
    <div class="modal fade aws-modal" id="resetPasswordModal" data-bs-backdrop="static" data-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="aws-title2 mb-3">Reset Password</div>
                <div class="aws-alert-info mb-3" style="font-size: 12px;">
                    <span class="text-danger"><i class="bi bi-filetype-key"></i> Note:- </span>Password format should be like 'Minimum 8 characters (atleast one special character &amp; one numeric character)'
                </div>
                <div class="aws-form">
                    @using (Html.BeginForm("ResetPasswordSubmit", "Members", FormMethod.Post, new { id = "ResetPwdForm", name = "ResetPwdForm" }))
                    {
                        <input type="hidden" name="token" value="@token" />
                        <div class="row">
                            <div class="col-md-12">
                                <fieldset class="toggle-password">
                                    <legend class="float-none w-auto px-1">New Password <span class="input-imp">*</span></legend>
                                    <input class="input-box" type="password" id="NewPassword" name="NewPassword" placeholder="New Password*">
                                    <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('NewPassword', this)"></i>
                                </fieldset>
                            </div>
                            <div class="col-md-12">
                                <fieldset class="toggle-password">
                                    <legend class="float-none w-auto px-1">Retype Password <span class="input-imp">*</span></legend>
                                    <input class="input-box" type="password" id="ConfPassword1" name="ConfPassword1" placeholder="Retype Password*">
                                    <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('ConfPassword1', this)"></i>
                                </fieldset>
                            </div>
                            <div class="col-md-12"><span id="resetPwdError" class="text-danger" style="font-size:13px;"></span></div>
                            <div class="col-md-12 text-end">
                                <button type="submit" id="btnResetPwd" class="aws-btn3">Submit</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade aws-modal" id="resetSuccessModal" data-bs-backdrop="static" data-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content text-center" style="padding:20px;">
                <div style="font-size:44px;">✅</div>
                <div class="aws-title2 mb-2">Password Updated</div>
                <p>Your new password has been updated successfully.</p>
                <div>
                    <a href="@Url.Action("LogOn", "Members", new { cname = cname })" class="aws-btn3" style="display:inline-block;">Click here to Login</a>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(document).ready(function () {
        @if (tokenValid)
        {
                <text>
                $('#resetPasswordModal').modal('show');

                $('#ResetPwdForm').on('submit', function (e) {
                    e.preventDefault();
                    var np = $('#NewPassword').val(), cp = $('#ConfPassword1').val();
                    var $err = $('#resetPwdError').text('');

                    if (!np || !cp) { $err.text('Please enter both password fields.'); return; }
                    if (np !== cp) { $err.text('Passwords do not match.'); return; }
                    if (!/^(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/.test(np)) {
                        $err.text('Minimum 8 characters, at least one special character & one numeric character.');
                        return;
                    }

                    $('#btnResetPwd').prop('disabled', true);
                    $.post($(this).attr('action'), $(this).serialize())
                        .done(function (res) {
                            if (res.ok) {
                                $('#resetPasswordModal').modal('hide');
                                $('#resetSuccessModal').modal('show');
                            } else if (res.expired) {
                                window.location.reload();   // expired message page chupistundi
                            } else {
                                $err.text(res.message);
                                $('#btnResetPwd').prop('disabled', false);
                            }
                        })
                        .fail(function () {
                            $err.text('Something went wrong. Please try again.');
                            $('#btnResetPwd').prop('disabled', false);
                        });
                });
                </text>
        }
    });
</script>