                }

                // Extracting unit amount and ensuring it's properly formatted
                var unitAmount = parseFloat(item[1].trim()).toFixed(2);
                if (isNaN(unitAmount) || unitAmount <= 0) {
                    console.error('Invalid unit amount:', unitAmount);
