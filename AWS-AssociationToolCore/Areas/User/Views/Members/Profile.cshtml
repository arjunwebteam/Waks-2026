<script>
    function checkChildrenAges() {
    $('.child-row').each(function() {
        var $row = $(this);
        var ageInput = $row.find('input[id^="Age-"]');
        var nameInput = $row.find('input[id^="FirstName-"]');
        
        if (ageInput.length && nameInput.length) {
            var age = parseInt(ageInput.val());
            var name = nameInput.val();
            
            // Remove existing alert if any
            $row.next('.age-alert-container').remove();
            
            // Add alert if age >= 16
            if (age >= 16) {
                var alertHtml = `
                    <div class="age-alert-container">
                        <div class="age-alert warning">
                            <span class="age-alert-text">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                               
                                 <strong>${name}</strong> is ${age} years old now. A quick reminder to register for individual membership if not done already, so they don't miss out on future event benefits. Already registered? Please ignore this note
                            </span>
                          <a href="https://square.link/u/WKx71TDU"
   target="_blank"
   rel="noopener noreferrer"
   class="membership-register-btn">
    <i class="bi bi-plus-circle"></i> Pay Now
</a>
                        </div>
                    </div>
                `;
                $row.after(alertHtml);
            }
        }
    });
}

