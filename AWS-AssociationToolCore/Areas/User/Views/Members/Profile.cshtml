        function initDatepickers(context) {
            $(context).find('[id^="Relationship-"]').each(function () {
                if (!$(this).hasClass('hasDatepicker')) {
                    var $ageInput = $(this).closest('.child-row').find('[id^="Age-"]');

                    $(this).datepicker({
                           dateFormat: 'dd/mm/yy',
                        changeMonth: true,
                        changeYear: true,
                        yearRange: '1950:' + new Date().getFullYear(),
                        maxDate: new Date(),
                        showOn: 'focus',  // Removed button icon
                        onSelect: function(dateText) {
                            calculateAge(this, $ageInput);
                        }
                    });
                }
            });
        }

        function calculateExistingAges() {
            $('#sriman #childinfo .child-row').each(function() {
                var $dateInput = $(this).find('[id^="Relationship-"]');
                var $ageInput = $(this).find('[id^="Age-"]');

                if ($dateInput.length && $ageInput.length && $dateInput.val()) {
                    var dateParts = $dateInput.val().split('/');
                    if (dateParts.length === 3) {
                        var selectedDate = new Date(dateParts[2], dateParts[0] - 1, dateParts[1]);
                        if (!isNaN(selectedDate)) {
                            var today = new Date();
                            var age = today.getFullYear() - selectedDate.getFullYear();
                            var m = today.getMonth() - selectedDate.getMonth();
                            if (m < 0 || (m === 0 && today.getDate() < selectedDate.getDate())) {
                                age--;
                            }
                            $ageInput.val(age);
                        }
                    }
                }
            });
        }

        function addRow() {
            var $editChildInfo = $('#sriman #childinfo');
