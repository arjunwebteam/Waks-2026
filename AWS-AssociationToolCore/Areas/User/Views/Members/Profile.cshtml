        function deleteRow(button) {
            var row = $(button).closest('.child-row');
            if (row.index() !== 0) {
                row.remove();
            }
        }

        function calculateAge(datepickerElement, ageInputElement) {
            var selectedDate = $(datepickerElement).datepicker('getDate');
            if (selectedDate) {
                var today = new Date();
                var age = today.getFullYear() - selectedDate.getFullYear();
                var m = today.getMonth() - selectedDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < selectedDate.getDate())) {
                    age--;
                }
                $(ageInputElement).val(age);
            } else {
                $(ageInputElement).val('');
            }
        }





