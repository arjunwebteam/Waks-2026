                        data:        formData,
                        processData: false,
                        contentType: false,
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            // Server returns JSON with redirect URL
                           if (response && response.redirectUrl) {
            // Server returned JSON with redirect URL — go there
            window.location.href = response.redirectUrl;
        } else {
            // Fallback — should rarely happen
            window.location.href = '@Url.Action("Acknowledgement", "Services", new { area = "User" })'
                + '?ServiceDonationId=' + ($('#ServiceDonationId').val() || 0)  // ← fixed: ddMembersId not ServiceDonationId
                + '&cname=' + encodeURIComponent(cnameValue);
        }
                        },
                        error: function (xhr) {
                            console.error('Submit error:', xhr.status, xhr.responseText);
                            $('#payment-status').html(
                                '<div class="alert alert-danger">Submission failed (HTTP ' + xhr.status + '). Payment was captured. Please contact support with Transaction ID: ' + transactionId + '</div>'
                            );
                        }
                    });

                } else {
                    $('#payment-status').html(
                        '<div class="alert alert-warning">Payment status: ' + status + '</div>'
                    );
                }
            }).catch(function (err) {
                console.error('Capture error:', err);
                $('#payment-status').html(
                    '<div class="alert alert-danger">Error: ' + err.message + '</div>'
