                    );
                    $('#paypal-button-container').hide();

                    // Use FormData to include files + antiforgery token
                    var formData = new FormData(document.getElementById('SignupForm'));

                    $.ajax({
                        url:         '@Url.Action("AddServiceDonation", "Services", new { area = "User" })',
