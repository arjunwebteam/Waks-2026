            });
                // ✅ FIX: Trigger validation on blur and keyup for Amount
                $('#round_no').on('blur keyup', function () {
                    $('#SignupForm').validate().element('#round_no');
                });

            // ─────────────────────────────────────────────
            // NORMAL SUBMIT (NON-PAYPAL)
            // ─────────────────────────────────────────────

               $('#submit-button').on('click', function (e) {
            e.preventDefault();

            var form = $('#SignupForm');
            var paymentMethod = $('#PaymentMethod').val();

            // ✅ Special handling for Credit Card (BrainTree)
            if (paymentMethod === 'Credit Card') {

                // Step 1: Validate form first
                if (!form.valid()) {
                    return;
                }

                // Step 2: Check drop-in instance exists
                if (!window.dropinInst) {
                    alert('Payment form not ready. Please wait and try again.');
                    return;
                }

                // Step 3: Check card details filled
                if (!window.dropinInst.isPaymentMethodRequestable()) {
                    alert('Please fill in your card details before submitting.');
                    return;
                }

                // Step 4: Request nonce from BrainTree
                window.dropinInst.requestPaymentMethod(function (err, payload) {
                    if (err) {
                        alert('Card error: ' + err.message);
                        return;
                    }

                    // ✅ Write nonce to hidden input INSIDE the form
                    $('#nonce').val(payload.nonce);
                    console.log('Nonce set in form:', payload.nonce);

                    // Step 5: Now submit the form
                    $('<input>').attr({
                        type:  'hidden',
                        name:  'ClientValidationStatus',
                        value: 'true'
                    }).appendTo(form);

                    form.submit();
                });

                return; // ← stop here for Credit Card
            }

            // ✅ Normal submit for other payment methods
            if (form.valid()) {
                $('<input>').attr({
                    type:  'hidden',
                    name:  'ClientValidationStatus',
                    value: 'true'
                }).appendTo(form);
                form.submit();
            }
        });
            // ─────────────────────────────────────────────
            // PAYPAL BUTTON VISIBILITY
            // ─────────────────────────────────────────────

            $('#round_no').on('input', function () {
                if ($(this).val()) {
                    $('#paypal-button-container').show();
                } else {
                    $('#paypal-button-container').hide();
                }
            });

            // ─────────────────────────────────────────────
            // PAYPAL INTEGRATION
            // ─────────────────────────────────────────────

                  if (typeof paypal !== 'undefined') {
            paypal.Buttons({
                fundingSource: paypal.FUNDING.PAYPAL,
                style: { layout: 'horizontal', color: 'blue', shape: 'pill', label: 'pay', height: 40 },

                onInit: function (data, actions) {
                    actionStatus = actions;

                    // Initially disable if form is invalid
                    if (!$('#SignupForm').valid() || !$('#round_no').val()) {
                        actions.disable();
                    } else {
                        actions.enable();
                    }

                    // Show/hide PayPal button container
                    if ($('#PaymentMethod').val() === 'PayPal') {
                        $('#paypalbuttonshow').show();
                        $('#paypal-button-container').show();
                        $('#button-show').hide();
                    }

                    // Form validation listener
                    var debounceTimer;
                       // ✅ Use .off() before .on() to prevent stacking
            $('#SignupForm').off('change keyup').on('change keyup', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if ($('#SignupForm').valid() && $('#round_no').val()) {
                        actionStatus.enable();
                    } else {
                        actionStatus.disable();
                    }
                }, 300);
            });
                },

                onClick: function (data, actions) {
                    // Validate form before opening PayPal popup
                    if (!$('#SignupForm').valid()) {
                        $('#SignupForm').valid();
                        alert('Please fill all required fields');
                        return actions.reject();
                    }

                    var amount = $('#round_no').val();
                    if (!amount || parseFloat(amount) <= 0) {
                        alert('Please enter a valid amount');
                        return actions.reject();
                    }
                          if (!$('#SignupForm').valid() || !$('#round_no').val()) {
                return actions.reject(); // ✅ Hard stop
            }
                    return actions.resolve();
                },

                createOrder: function (data, actions) {
                    var amount = $('#round_no').val();
                    var membershipTypeValue = $('#DonationCause1').val();
                    var item = membershipTypeValue.split('###');

                    // Create PayPal order directly - NO server call first
                    return actions.order.create({
                        purchase_units: [{
                            amount: {
                                currency_code: 'USD',
                                value: amount
                            },
                            description: item[0] || "Membership",
                            custom_id: $('#DonationCause1').val()
                        }],
                        application_context: {
                            shipping_preference: 'NO_SHIPPING'
                        }
                    });
                },

           onApprove: function (data, actions) {
            return actions.order.capture().then(function (details) {
                var transactionId = details.id;
                var amount        = details.purchase_units[0].amount.value;
                var status        = details.status;
                var payerName     = details.payer.name.given_name + ' ' + details.payer.name.surname;
                var payerEmail    = details.payer.email_address;

                if (status === 'COMPLETED') {
                    $('#TransactionId').val(transactionId);
