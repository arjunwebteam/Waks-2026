    function addCauseRow() {

        var table = document.getElementById("contributionfo");

        var rowCount = table.rows.length;
        var row = table.insertRow(rowCount);
        row.id = rowCount;

        var cell1 = row.insertCell(0);
        var element1 = document.createElement("article");
        element1.className = "clearfix dropdown";
        element1.innerHTML = " <select class=\"dropdown-select ui-select\" id=\"ServiceId-" + (rowCount - 1) + "\" name=\"[" + (rowCount - 1) + "].ServiceId\" style=\"min-height:40px; background-color:#fff;\" onchange=\"contributionupdate();\" ></select>";
