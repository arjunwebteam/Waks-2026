            },
            onInit: function (data, actions) {
                actions.disable();
                actionStatus = actions;
                $("form[id='SignupForm']").on('change keyup', function () {
                    if ($(this).valid()) {
                        actionStatus.enable();
                    } else {
                        actionStatus.disable();
                    }
                });

                // Log init
                $.post('/Services/PayPalSaveLog', { message: 'PayPal button initialized.' });
            },

            onClick: function () {
                if ($("form[id='SignupForm']").valid()) {
                    actionStatus.enable();
                } else {
                    $("form[id='SignupForm']").submit();
                    actionStatus.disable();
                    $.post('/Services/PayPalSaveLog', { message: 'Form invalid on PayPal button click.' });
                }
            },

            createOrder: function (data, actions) {
                if (!$("#SignupForm").valid()) {
                    $.post('/Services/PayPalSaveLog', { message: 'Form not valid. Rejecting order creation.' });
                    return actions.reject();
                }

                var amountElement = document.getElementById("round_no");
                if (!amountElement) {
                    $.post('/Services/PayPalSaveLog', { message: 'Amount element not found. Rejecting order.' });
                    return actions.reject();
                }

                var amount = amountElement.value;
                var membershipTypeValue = $('[name="DonationCause1"]').val();
                var item = membershipTypeValue.split('###');

                if (item.length !== 2 || !item[0] || !item[1]) {
                    $.post('/Services/PayPalSaveLog', { message: 'Invalid item data: ' + JSON.stringify(item) });
                    return actions.reject();
                }

                var unitAmount = parseFloat(item[1].trim()).toFixed(2);
                if (isNaN(unitAmount) || unitAmount <= 0) {
                    $.post('/Services/PayPalSaveLog', { message: 'Invalid unit amount: ' + unitAmount });
                    return actions.reject();
                }

                if (parseFloat(amount).toFixed(2) !== unitAmount) {
                    $.post('/Services/PayPalSaveLog', {
                        message: 'Amount mismatch. Amount: ' + amount + ', UnitAmount: ' + unitAmount
                    });
                    return actions.reject();
                }

                var recaptchaResponse = grecaptcha.getResponse();

                var formData = {
                    FirstName: $("#FirstName").val(),
                    LastName: $("#LastName").val(),
                    Email: $("#Email").val(),
                    PhoneNo: $("#PhoneNo").val(),

                    Country: $("#Country").val(),

                    ZipCode: $("#ZipCode").val(),
                    ServiceId: $("#ServiceId").val(),
                    Address: $("#Address").val(),
                    Field3: $("#Field3").val(),

                    membershipType: item[0].trim(),

                    Amount: amount,
                    ServiceDonationId: $('#ServiceDonationId').val(),
                    MemberId: $('#MemberId').val(),

                    recaptchaToken: recaptchaResponse
                };


                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Services/InsertPaymentAsync',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData),
                        success: function (response) {
                            $.post('/Services/PayPalSaveLog', {
                                message: 'InsertPaymentAsync Success. Response: ' + JSON.stringify(response)
                            });

                            if (response.success) {
                                $('#ServiceDonationId').val(response.paymentId);

                                resolve(actions.order.create({
                                    "purchase_units": [{
                                        "amount": {
                                            "currency_code": "USD",
                                            "value": amount,
                                            "breakdown": {
                                                "item_total": {
                                                    "currency_code": "USD",
                                                    "value": amount
                                                }
                                            }
                                        },
                                        "items": [{
                                            "name": item[0].trim(),
                                            "description": item[0].trim(),
                                            "unit_amount": {
                                                "currency_code": "USD",
                                                "value": unitAmount
                                            },
                                            "quantity": "1"
                                        }]
                                    }],
                                    "application_context": {
                                        "shipping_preference": "NO_SHIPPING"
                                    }
                                }));
                            } else {
                                $.post('/Services/PayPalSaveLog', { message: 'InsertPaymentAsync failed: ' + JSON.stringify(response) });
                                reject(new Error('Failed to insert payment data.'));
                            }
                        },
                        error: function (xhr, status, error) {
                            $.post('/Services/PayPalSaveLog', {
                                message: 'AJAX error in InsertPaymentAsync: ' + error
                            });
                            reject(new Error('AJAX request failed: ' + error));
                        }
                    });
                });
            },

            onApprove: function (data, actions) {
                return actions.order.capture().then(function (details) {
                    var transactionDetails = {
                        payerName: details.payer.name.given_name + ' ' + details.payer.name.surname,
                        payerEmail: details.payer.email_address,
                        transactionId: details.purchase_units[0].payments.captures[0].id,
                        amount: details.purchase_units[0].amount.value,
                        currency: details.purchase_units[0].amount.currency_code,
                        status: details.status,
                        receiverEmail: details.purchase_units[0].payee.email
                    };

                    $.post('/Services/PayPalSaveLog', {
                        message: 'Payment approved. Details: ' + JSON.stringify(transactionDetails)
                    });

                    document.getElementById("TransactionId").value = transactionDetails.transactionId;
                    document.getElementById("PaymentAmount").value = transactionDetails.amount;
                    document.getElementById("PaymentStatus").value = transactionDetails.status;
                    var pid = $('#ServiceDonationId').val();

                    if (transactionDetails.status === "COMPLETED") {
                        document.getElementById("payment-status").innerHTML =
                            `<div class="alert alert-success">Payment completed successfully by ${transactionDetails.payerName}.</div>`;

                        document.getElementById("paypal-button-container").style.display = 'none';

                        setTimeout(function () {
                            document.getElementById("SignupForm").submit();
                        }, 500);

                        setTimeout(function () {
                            window.location.href = '/service-acknowledgement?ServiceDonationId=' + pid;
                        }, 1500);
                    } else {
                        document.getElementById("payment-status").innerHTML =
                            `<div class="alert alert-warning">Payment status: ${transactionDetails.status}.</div>`;
                    }
                }).catch(function (error) {
                    $.post('/Services/PayPalSaveLog', {
                        message: 'Error capturing PayPal payment: ' + error.message
                    });
                    document.getElementById("payment-status").innerHTML =
                        `<div class="alert alert-danger">Error processing payment: ${error.message}</div>`;
                });
            },

            onError: function (err) {
                $.post('/Services/PayPalSaveLog', { message: 'PayPal error: ' + err.toString() });
                document.getElementById("submit-button").disabled = false;
            },

            onCancel: function (data) {
                $.post('/Services/PayPalSaveLog', { message: 'User canceled PayPal payment.' });
                document.getElementById("submit-button").disabled = false;
            }
        }).render('#paypal-button-container');

    });
</script>
