        var element2 = document.createElement("input");
        element2.type = "text";
        element2.name = "[" + (rowCount - 1) + "].Percentage";
        element2.id = "Percentage-" + (rowCount - 1);
        element2.className = "form-control dis-in per_class";
        element2.style = "min-height:40px; background-color:#fff";
        cell2.appendChild(element2);


        var cell3 = row.insertCell(2);
        cell3.align = 'center';
        cell3.innerHTML = '<span id="del-' + (rowCount - 1)+'"><a onclick="javascript:deleteRow(' + rowCount + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a></span>';
        $('#hdnRowCount').val(rowCount);

        $("#Percentage-" + (rowCount - 1)).attr('onchange', 'sumpercentage()').attr('onkeypress', 'return Common.isNumberKey(event)');

        ServicesList(rowCount - 1);
        $('#del-' + (rowCount - 2)).html('');
        if ((rowCount) == @TotalServices) {
            $('#spp2').hide();
        }
    }

    function deleteRow(i) {
        try {
            var row = document.getElementById(i);
            row.parentNode.removeChild(row);
            contributionupdate();
            $('#del-' + (i - 2)).html('<a onclick="javascript:deleteRow(' + (i-1) + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a>');
            var table = document.getElementById("contributionfo");
            var rowCount = table.rows.length;
            if ((rowCount - 2) < 4) {
                $('#spp2').show();
            }

        } catch (e) {
            alert(e);
        }
    }

    $(document).ready(function () {
        $('#round_no').on('input', function () {
            let amt = $(this).val().replace(/\D/g, ''); // Remove non-numeric characters
            $(this).val(amt); // Set input field to whole number
            round_off();
        });
    });

    // ── Debounce timer for Braintree init ──────────────────
    var braintreeInitTimer = null;

    function round_off() {
        var return_val = true;
        var type = $('#PaymentMethod').val();

        // ─────────────────────────────────────────────
        // PAYMENT BUTTON VISIBILITY
        // ─────────────────────────────────────────────
        if (type === "PayPal") {
            $('#paypal-button-container').show();
            $('#submit-button').hide();
            $('#button-show').show();
            $('#paypalbuttonshow').show();
        } else if (type === "Credit Card") {
            // ✅ FIX 1: Hide PayPal button completely when Credit Card is selected
            $('#paypal-button-container').hide();
            $('#paypalbuttonshow').hide();
            $('#button-show').show();
            $('#submit-button').show();
        } else {
            $('#paypal-button-container').hide();
            $('#paypalbuttonshow').hide();
            $('#button-show').show();
            $('#submit-button').show();
        }

        // ─────────────────────────────────────────────
        // AMOUNT EMPTY CHECK
        // ─────────────────────────────────────────────
        if ($('#round_no').val() === "") {
            $('#spanAmount').hide().html('');
            $('#Disblbtn').show();
            $('#Mainbtn').hide();
            $('#BT_Amount').val('');
            window.NEW_PAYMENT_AMOUNT = '';
            return false;
        }

        // ─────────────────────────────────────────────
        // AMOUNT PROCESSING
        // ─────────────────────────────────────────────
        var amt  = $('#round_no').val();
        var amt1 = parseInt(amt, 10);

        if (isNaN(amt1)) {
            $('#spanAmount').html('Please enter a valid amount.');
            return false;
        }

        $('#amount1').val(amt1);
        $('#round_no').val(amt1);
        $('#BT_Amount').val(amt1);

        var formattedAmt = amt1.toFixed(2);

        // ─────────────────────────────────────────────
        // UPDATE ALL AMOUNT DISPLAY SPANS
        // ─────────────────────────────────────────────
        $('#payamount').html(formattedAmt);
        $('#totalamountzelle').html(formattedAmt);
        $('#creditamount').html(formattedAmt);
        $('#totalamountcash').html(formattedAmt);
        $('#totalstripe').html(formattedAmt);
        $('#totalswirepay').html(formattedAmt);

        // ─────────────────────────────────────────────
        // ✅ FIX 2: Braintree — debounced init (800ms delay after typing stops)
        // ─────────────────────────────────────────────
        $('#BT_Amount').val(formattedAmt);
        window.NEW_PAYMENT_AMOUNT = formattedAmt;

        $(document).trigger("amount-updated");

        if (type === "Credit Card" && typeof window.startBraintree === 'function') {
            // ✅ Clear any pending timer — only init after user stops typing
            clearTimeout(braintreeInitTimer);
            braintreeInitTimer = setTimeout(function () {
                window.startBraintree();
            }, 800); // 800ms delay — adjust as needed
        }

        // ─────────────────────────────────────────────
        // DONATION CAUSE
        // ─────────────────────────────────────────────
        $('#DonationCause1').val("Donation Registration###" + formattedAmt);

        // ─────────────────────────────────────────────
        // AMOUNT VALIDATION
        // ─────────────────────────────────────────────
        if (amt1 >= 5) {
            $('#spanAmount').html('');
            $('#Disblbtn').hide();
            $('#Mainbtn').show();

            if (type === "PayPal" && typeof actionStatus !== 'undefined') {
                try { actionStatus.enable(); } catch (e) {}
            }
        } else {
            $('#spanAmount').html('Amount &lt; 5.00 USD.');
            $('#Disblbtn').show();
            $('#Mainbtn').hide();

            if (typeof actionStatus !== 'undefined') {
                try { actionStatus.disable(); } catch (e) {}
            }

            return_val = false;
        }

        return return_val;
    }

    function RECAMTBIND() {
        if ($('#RecurrCheckbox').prop("checked") == true) {
            $('#Field1').val($('#round_no').val());
        }
    }
    function RecurrDivFunction() {
        if ($('#RecurrCheckbox').prop("checked") == true) {
            $('#Field1').val($('#round_no').val());
            $('#RecurrDiv').show('slow');
        }
        else {
            $('#RecurringAmount').val('');
            $('#RecurringType').val('');
            $('#RecurringStartTime').val('');
            $('#RECDate').val('');
            $('#RType').val('');
            $('#ReccurId').val('');
            $('#RecurrDiv').hide('slow');
        }
    }

    function contributionupdate() {
        var table = document.getElementById("contributionfo");
        var rowCount = table.rows.length;
        var rows = rowCount - 1;
        var per = (100 / rows).toFixed(2);
        $('.per_class').val(per);
        sumpercentage();
        //for (var i = 0; i <= rows; i++) {

        //    $("#Percentage-" + i).val(per);
        //}
    }

    function sumpercentage() {
        var sum = 0;
        $(".per_class").each(function () {
            sum += +$(this).val();
        });
        $("#TotalPercent").val(sum);
        if ($('#GID').val() == 1) {
            $('#GID').val(0);
        }
        else {
            Validate();
        }
    }

    function ServicesList(rowid) {
        $.ajax({
            url: '@Url.Action("ServicesGetListByChapterId", "Services")',
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result.ok) {
                    var lstServices = result.data;
                    var sb1 = "";
                    if (lstServices != null) {
                        var table = document.getElementById("contributionfo");
                        var rowCount = table.rows.length;
                        var rows = rowCount - 1;

                        for (var k = 0; k < lstServices.length; k++) {
                            var x = 0;
                            for (var i = 0; i <= rows; i++) {
                                if (lstServices[k].ServiceId == $('#ServiceId-' + i).val()) {
                                    x = 1;
                                }
                            }
                            if (x == 0) {
                                sb1 = sb1 + "<option value=\"" + lstServices[k].ServiceId + "\">" + lstServices[k].ServiceTitle + "</option>";
                            }
                        }
                    }
                    $('#ServiceId-' + rowid).append(sb1);
                    //if (rowid == 0) {
                    //    $('#ServiceId-' + rowid).val(10);
                    //    contributionupdate();
                    //}
                    contributionupdate();
                }
            }
        });
    }

    function Validates(stype) {
        var return_val = true;
        var alertvalidation = '';
        var validationcount = 0;
        var alertimg = '<img src="Content/User/images/alert-icon.png" alt="alert" width="20" height="19"> ';


        var amt = $('#round_no').val();
        var needamt = Math.round((500000), 0);
        if (amt == 0) { $('#spanAmount').hide().html(''); return_val = false;}
        else {
            $('#spanAmount').hide().html('');
            if (amt < 5) {
                $('#spanAmount').html('');
                $('#spanAmount').html('Please enter amount atleast $5.'); return_val = false;
            }
            else if (amt > needamt && '@objServices.ServiceId' != 0)
            { $('#spanAmount').html(''); $('#spanAmount').html('Entered amount is exceeded.'); return_val = false; }
            else { $('#spanAmount').html(''); RECAMTBIND();}
        }

        if (alertvalidation != "" && stype == "final") {
            $('#alertvalidation').html(alertvalidation);
            ValidationAlertShow();
        }


        return return_val;
    }

