                                        $('#card-button').hide();
                                        $('#hidebutton').hide();
                                        $('#square-timer-display').hide();
                                    }

                    else {
                        $('#paypalbuttonshow').hide();
                        $('#paypal-button-container').hide();
                        $('#button-show').show();
                    }

                    $('#PaymentMethod').val(type);

                    // 🆕 Activate tab content panel
                   var tabId = $('.cus-tab-label[value="' + type + '"]').data('tab');



                    $('.cus-tab-pane').removeClass('active').hide(); // Hide all
                    $('#' + cleanedTabId).addClass('active').show(); // Show the matched tab

                    // 🆕 Highlight the selected tab button (optional)
                    $('.cus-tab-label').removeClass('active');
                    $('.cus-tab-label[value="' + type + '"]').addClass('active');

                    paymentsettings(type);

                    // Reset all validation rules
                    //$("#SignupForm").validate().resetForm();

                    // Add validation rules based on selected gateway
                    if (selectedGateway === "AuthorizeNet") {
                        $("#CardNumber").rules("add", { required: true, creditcard: true });
                        $("#CardName").rules("add", { required: true });
                        $("#Cvv").rules("add", { required: true });
                        $("#CSVYear").rules("add", { required: true });
                        $("#CSVMonth").rules("add", { required: true });
                    } else if (selectedGateway === "Zelle") {
                        $("#Zelle").rules("add", { required: true });
                        $("#ZellePartnerName").rules("add", { required: true });
                        $("#filezelle").rules("add", { required: true });
                    } else if (selectedGateway === "Cash/Cheque") {
                        $("#file2").rules("add", { required: true });
                    }

                    // Remove rules not relevant to the selected gateway
                    if (selectedGateway !== "AuthorizeNet") {
                        $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
                    }
                    if (selectedGateway !== "Zelle") {
                        $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
                    }
                    if (selectedGateway !== "Cash/Cheque") {
                        $("#file2").rules("remove");
                    }

                }


            </script>
