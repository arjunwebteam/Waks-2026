                {
                    <li class="treeview" id="w@(item.DisplayName.Replace(" ", ""))">


                        @if (userRole.Contains("SuperAdmin") && item.DisplayName == "Developers")
                        {

                        }
                        else
                        {
                            <a href="javascript:;" class="has-arrow">
                                <div class="parent-icon"><i class="bi bi-list-task"></i></div>
                                <div class="menu-title">@item.DisplayName</div>
                            </a>



                            <ul>
                                @foreach (var submenu in lstSubmenuCount)
                                {
                                    if (submenu.PageParentId == item.MenuItemId)
                                    {
                                        if (submenu.DisplayName == "Active Members" || submenu.DisplayName == "Inactive Members" || submenu.DisplayName == "Pending Members")
                                        {
                                            <li id="w@(submenu.DisplayName.Replace(" ", ""))"> <a href="@submenu.PageUrl&mid=@submenu.MenuItemId"><i class="bi bi-arrow-right-short"></i>@submenu.DisplayName</a></li>





                                        }
                                        else
                                        {
                                            <li id="w@(submenu.DisplayName.Replace(" ", ""))"> <a href="@submenu.PageUrl?mid=@submenu.MenuItemId"><i class="bi bi-arrow-right-short"></i>@submenu.DisplayName</a></li>

                                        }
                                    }
                                }
                            </ul>
                        }




                    </li>
                }
                else
                {
                    <li id="w@(item.DisplayName.Replace(" ", ""))">
                        @if (item.DisplayName == "Events")
                        {
                            <a href="@item.PageUrl&mid=@item.MenuItemId">
                                <div class="parent-icon"><i class="bi bi-list-task"></i></div>
                                <div class="menu-title">@item.DisplayName</div>
                            </a>
                        }
                        else
                        {
                            <a href="@item.PageUrl?mid=@item.MenuItemId">
                                <div class="parent-icon"><i class="bi bi-list-task"></i></div>
                                <div class="menu-title">@item.DisplayName</div>
                            </a>
                        }
                    </li>
                }
            }
        }
    }
    else
    {
        if (lstMainMenu != null && lstMainMenu.Count != 0)
        {
            foreach (var item in lstMainMenu)
            {
                lstSubmenuCount = lstSubMenu.FindAll(x => x.PageParentId == item.MenuItemId);
                if (lstSubmenuCount != null && lstSubmenuCount.Count != 0)
                {
                    bool hasActiveChild = lstSubmenuCount.Any(x =>
                        !string.IsNullOrEmpty(x.PageUrl) &&
                        URL.IndexOf(x.PageUrl, StringComparison.OrdinalIgnoreCase) >= 0);

                    string parentLiClass = hasActiveChild ? "treeview mm-active" : "treeview";
                    string parentAClass = hasActiveChild ? "has-arrow mm-active" : "has-arrow";
                    string subUlStyle = hasActiveChild ? "display:block;" : "";

                    <li class="@parentLiClass" id="w@(item.DisplayName.Replace(" ", ""))">
                        <a href="javascript:;" class="@parentAClass">
                            <div class="parent-icon"><i class="bi bi-list-task"></i></div>
                            <div class="menu-title">@item.DisplayName</div>
                        </a>
                        <ul style="@subUlStyle">
                            @foreach (var submenu in lstSubmenuCount)
                            {
                                if (submenu.PageParentId == item.MenuItemId)
                                {
                                    bool isActive = !string.IsNullOrEmpty(submenu.PageUrl) &&
                                        URL.IndexOf(submenu.PageUrl, StringComparison.OrdinalIgnoreCase) >= 0;
                                    string liClass = isActive ? "mm-active active" : "";

                                    if (submenu.DisplayName == "Active Members" || submenu.DisplayName == "Inactive Members" || submenu.DisplayName == "Pending Members")
                                    {
                                        <li class="@liClass" id="w@(submenu.DisplayName.Replace(" ", ""))"><a class="@liClass" href="@submenu.PageUrl&mid=@submenu.MenuItemId"><i class="bi bi-arrow-right-short"></i>@submenu.DisplayName</a></li>
                                    }
                                    else
                                    {
                                        <li class="@liClass" id="w@(submenu.DisplayName.Replace(" ", ""))"><a class="@liClass" href="@submenu.PageUrl?mid=@submenu.MenuItemId"><i class="bi bi-arrow-right-short"></i>@submenu.DisplayName</a></li>
                                    }
                                }
                            }
                        </ul>
                    </li>
                }
                else
                {
                    bool isActive = !string.IsNullOrEmpty(item.PageUrl) &&
                        URL.IndexOf(item.PageUrl, StringComparison.OrdinalIgnoreCase) >= 0;
                    string liClass = isActive ? "mm-active active" : "";

                    <li class="@liClass" id="w@(item.DisplayName.Replace(" ", ""))">
                        @if (item.DisplayName == "Events")
                        {
                            <a class="@liClass" href="@item.PageUrl&mid=@item.MenuItemId"><i class="fa fa-bars"></i><span>&nbsp;&nbsp;@item.DisplayName</span></a>
                        }
                        else
                        {
                            <a class="@liClass" href="@item.PageUrl?mid=@item.MenuItemId"><i class="fa fa-bars"></i><span>&nbsp;&nbsp;@item.DisplayName</span></a>
                        }
                    </li>
                }
            }
        }

    }
