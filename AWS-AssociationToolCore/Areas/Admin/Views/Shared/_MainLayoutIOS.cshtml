    <script>
        $(document).on('click', '#btnOpenChangePasswordApp', function () {
            $.ajax({
                url: '@Url.Action("ChangePasswordApp", "Account")',
                type: 'GET',
                cache: false,
                success: function (html) {
                    $('#changePasswordAppContent').html(html);
                    $('#changePasswordAppModal').modal('show');
                    bindChangePasswordAppValidation();
                }
            });
        });

        function bindChangePasswordAppValidation() {
            $('#FormChangePasswordApp').validate({
                rules: {
                    OldPassword: { required: true },
                    NewPassword: { required: true, minlength: 6 },
                    ConfirmPassword: { required: true, minlength: 6, equalTo: '#AppNewPassword' }
                },
                messages: {
                    OldPassword: { required: 'Required.' },
                    NewPassword: { required: 'Required.', minlength: 'At least 6 characters.' },
                    ConfirmPassword: { required: 'Required.', equalTo: 'Passwords do not match.' }
                },
                errorElement: 'div',
                errorPlacement: function (error, element) {
                    error.addClass('invalid-feedback');
                    error.insertAfter(element.closest('.password-wrapper'));
                },
                highlight: function (element) {
                    $(element).addClass('is-invalid').removeClass('is-valid');
                },
                unhighlight: function (element) {
                    $(element).removeClass('is-invalid');
                },
                submitHandler: function () {
                    submitChangePasswordApp();
                    return false;
                }
            });
        }

        function submitChangePasswordApp() {
            $.ajax({
                url: '@Url.Action("ChangePasswordApp", "Account")',
                type: 'POST',
                cache: false,
                data: {
                    OldPassword: $('#AppOldPassword').val().trim(),
                    NewPassword: $('#AppNewPassword').val().trim(),
                    ConfirmPassword: $('#AppConfPassword').val().trim()
                },
                          success: function (result) {
            // clear any previous server errors first
            $('#OldPasswordServerError, #NewPasswordServerError, #ConfirmPasswordServerError').text('').hide();
            $('#AppOldPassword, #AppNewPassword, #AppConfPassword').removeClass('is-invalid');

            if (result.success) {
                showLobiboxNotification('success', result.message);
                $('#changePasswordAppModal').modal('hide');
                $('#FormChangePasswordApp')[0].reset();
            } else if (result.field === 'OldPassword') {
                $('#AppOldPassword').addClass('is-invalid');
                $('#OldPasswordServerError').text(result.message).show();
            } else if (result.field === 'NewPassword') {
                $('#AppNewPassword').addClass('is-invalid');
                $('#NewPasswordServerError').text(result.message).show();
            } else if (result.field === 'ConfirmPassword') {
                $('#AppConfPassword').addClass('is-invalid');
                $('#ConfirmPasswordServerError').text(result.message).show();
            } else {
                showLobiboxNotification('warning', result.message);
            }
        },
                error: function () {
            
                    showLobiboxNotification('error', 'Failed transaction.');
                }
            });
                }$(document).on('keyup', '#AppOldPassword', function () {
            $('#OldPasswordServerError').text('').hide();
            $(this).removeClass('is-invalid');
        });

        $(document).on('click', '.toggle-password-app', function () {
            var target = $($(this).data('target'));
            if (target.attr('type') === 'password') {
                target.attr('type', 'text');
                $(this).removeClass('bi-eye-slash').addClass('bi-eye');
            } else {
                target.attr('type', 'password');
                $(this).removeClass('bi-eye').addClass('bi-eye-slash');
            }
        });
    </script>
