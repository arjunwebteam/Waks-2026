@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Event Registrations";
    Int64 ChapterId = ViewBag.ChapterId;

    Int64 EventId = ViewBag.EventId;
    string EventName = ViewBag.EventName;
    List<AWS_AssociationToolCore.Entities.EventRegistrationTypes> lstEventRegistrationTypes = ViewBag.lstEventRegistrationTypes;

    string userRole = HttpContextAccessor.HttpContext.Session.GetString("userrole") ?? "";

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;
}



<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortorder" name="hdnsortorder" value="Asc" type="hidden" />
<input id="hdnsortcolumn" name="hdnsortcolumn" value="EventUserInfoId" type="hidden" />

    <script>
        $(document).ready(function () {
            $('#wEvents').addClass('active');

            // ✅ Load list on page load
            EventRegistrationBind(1);

            $('.showhmap').click(function () {
                $('.hmap').toggle("slow");
            });

            $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
            $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

            PagerClickBind();
        });

        function PagerClickBind() {
            $(".pagination a").off("click").on("click", function () {
                EventRegistrationBind($(this).text());
            });
        }

        function sortresult(sortcolumn) {
            $('#hdnsortorder').val($('#hdnsortorder').val() === 'ASC' ? 'DESC' : 'ASC');
            $('#hdnsortcolumn').val(sortcolumn);
            EventRegistrationBind(1);
        }

        // ✅ Main list loader
        function EventRegistrationBind(Pageno) {
            var pageno = Common.Pageno(Pageno);
            $.ajax({
                url: '@Url.Action("EventUsersList", "EventRegistrations")',
                type: 'GET',
                cache: false,
                data: {
                    search:     $('#txtsearch').val(),
                    EventId:    '@EventId',
                    PageNo:     pageno,
                    SortColumn: $('#hdnsortcolumn').val(),
                    SortOrder:  $('#hdnsortorder').val(),
                    Items:      $('#txtitems').val(),
                    IsEdit:     '@IsEdit',
                    IsView:     '@IsView',
                    IsDelete:   '@IsDelete',
                    IsExport:   '@IsExport',
                    IsAdd:      '@IsAdd',
                    Mid:        '@Mid'
                },
                success: function (result) {
                    $('#divEventsList').html(result);
                    PagerClickBind();
                },
                error: function () {
                    $('#divEventsList').html('<p class="text-danger">Failed to load registrations.</p>');
                }
            });
        }

        function ClearSearch() {
            $('#txtsearch').val('');
            $('#hdnPageNo').val(1);
            EventRegistrationBind(1);
        }

        function Delete(EventUserInfoId) {
            if (!confirm("Do you want to delete this record?")) return;
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteEventUser", "EventRegistrations")',
                data: { EventUserInfoId: EventUserInfoId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    EventRegistrationBind($('#hdnPageNo').val());
                },
                error: function () {
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            });
        }

        function ExporttoExcel() {
        window.location.href = "Admin/EventRegistrations/EventuserExporttoExcel?Search="
                + $('#txtsearch').val()
                + "&EventId=" + '@EventId'
                + "&SortColumn=" + $('#hdnsortcolumn').val()
                + "&SortOrder=" + $('#hdnsortorder').val();
        }
    </script>

<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row gx-2">

            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search</label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch"
                               placeholder="Search by Name / Email / Phone No" />
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-2" id="clearhide">
                <div><label>&nbsp;</label></div>
                <button type="button" class="btn btn-primary px-3" onclick="EventRegistrationBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>

            <div class="col-lg-8 col-2 text-end" id="clearhide">

                <div><label>&nbsp;</label></div>
@* 
                <a class="btn btn-primary t-m15 white-t showhmap"
                   style="background-color:#F94C02; background-image:linear-gradient(to bottom right,#F94C02 0%,#F93002 100%); border-color:#f93402;">
                    Ticket Availability
                </a> *@

                @if (IsAdd)
                {
                    <a href="@Url.Action("AddRegistrations", "EventRegistrations", new { EventId, EventName, mid = Mid })"
                       class="btn btn-primary px-3">
                        Add Registration
                    </a>
                }

                @if (IsExport)
                {
                    <a class="cursor-pointer do"
                       data-bs-toggle="tooltip"
                       onclick="ExporttoExcel();"
                       title="Export Data"
                       style="border:0; background:transparent; border:1px solid #e8e6e7; padding:10px; border-radius:50%; background-color:#e8e6e7;">
                        <i class="lni lni-download" style="font-size:20px; color:black;"></i>
                    </a>
                }
            </div>

        </div>
    </div>

    <div class="card-header" style="border-bottom:0;">
        <div class="grayBackground nobL nobR hmap b-p10" style="display:none;">
            <div class="text-center">
                <h4><b>Ticket Availability:</b></h4>
            </div>
            <div class="filedsetInner clearfix">
                <table class="table table-hover table_vam font13" width="100%">
                    <thead>
                        <tr>
                            <th width="7%" style="background-color:#b20400; color:white;">S.No</th>
                            <th width="43%" style="background-color:#b20400; color:white;">Registration Type</th>
                            <th width="10%" style="background-color:#b20400; color:white;">Registrations</th>
                            <th width="10%" style="background-color:#b20400; color:white;">BOGO25</th>
                            <th width="10%" style="background-color:#b20400; color:white;">TANA25</th>
                            <th width="10%" style="background-color:#b20400; color:white;">NAGA25</th>
                            <th width="10%" style="background-color:#c5e955;">No.of Tickets</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <div id="divEventsList"></div>
</div>
<script>

    $(document).ready(function () {
        $.ajax({
            type : "GET",
            url  : '@Url.Action("EventUsersList", "EventRegistrations")',
            data : {
                IsEdit    : '@IsEdit',
                IsView    : '@IsView',
                IsDelete  : '@IsDelete',
                IsExport  : '@IsExport',
                IsAdd     : '@IsAdd',
                Mid       : '@Mid',
                EventId:    '@EventId',
                ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
            },
            success: function (data) {
                $("#divEventsList").html(data);
            },
            error: function () {
                $("#divEventsList").html('<p class="text-danger">Failed to load.</p>');
            }
        });
    });
</script>

