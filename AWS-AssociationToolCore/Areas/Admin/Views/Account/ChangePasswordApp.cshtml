@using System.Configuration
@model AWS_AssociationToolCore.Entities.ChangePasswordModel

<div class="modal-header">
    <h5 class="modal-title">Change Password</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form id="FormChangePasswordApp" class="row g-3">
        <div class="col-12">
    <label class="form-label">Old password</label>
    <div class="password-wrapper position-relative">
        <input type="password" name="OldPassword" id="AppOldPassword" class="form-control pe-5">
        <i class="bi bi-eye-slash toggle-password-app" data-target="#AppOldPassword"></i>
    </div>
    <div class="invalid-feedback" id="OldPasswordServerError"></div>
</div>
<div class="col-12">
    <label class="form-label">New Password</label>
    <div class="password-wrapper position-relative">
        <input type="password" name="NewPassword" id="AppNewPassword" class="form-control pe-5">
        <i class="bi bi-eye-slash toggle-password-app" data-target="#AppNewPassword"></i>
    </div>
    <div class="invalid-feedback" id="NewPasswordServerError"></div>
</div>
<div class="col-12">
    <label class="form-label">Confirm Password</label>
    <div class="password-wrapper position-relative">
        <input type="password" name="ConfirmPassword" id="AppConfPassword" class="form-control pe-5">
        <i class="bi bi-eye-slash toggle-password-app" data-target="#AppConfPassword"></i>
    </div>
    <div class="invalid-feedback" id="ConfirmPasswordServerError"></div>
</div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" form="FormChangePasswordApp" class="btn btn-primary">Submit</button>
</div>