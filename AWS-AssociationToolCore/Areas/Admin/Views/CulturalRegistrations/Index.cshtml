    function Delete(CulturalRegistrationId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteCulturalRegistrations", "CulturalRegistrations")',  // the URL of the controller action method
                data: { CulturalRegistrationId: CulturalRegistrationId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);

                    //$("#divmessage").html(result.data);
                    Onload($('#hdnPageNo').val());
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                }
            });
        }
    }

    function DeleteCulturalRegistrations(CulturalRegistrationId) {
