@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Cultural Registrations";



    Int64 ChapterId = ViewBag.ChapterId;

    long EventId = ViewBag.EventId ?? 0;


    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    var lstEvents = ViewBag.lstEvents as List<AWS_AssociationToolCore.Entities.Events>;



    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
}
<script>
    $(document).ready(function () {
        LoadEventsList();
    });

    function LoadEventsList() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("CulturalRegistrationsList", "CulturalRegistrations")',
            data: {
                IsEdit    : '@IsEdit',
                IsView    : '@IsView',
                IsDelete  : '@IsDelete',
                IsExport  : '@IsExport',
                IsAdd     : '@IsAdd',
                EventId:    '@EventId',

                Mid       : '@Mid',           // ✅ uses Mid variable not ViewBag.mid
                ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
            },
            success: function (data) {
                $("#divDetails").html(data);
            },
            error: function () {
                $("#divDetails").html('<p class="text-danger">Failed to load events.</p>');
            }
        });
    }
</script>

<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>
<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="UpdatedDate" />
<input id="hdnsortorder" type="hidden" value="Desc" />
<input id="hdnuserid" type="hidden" value="0" />
<!---  Breadcrumb Section Start ------>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row gx-2">
            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label"> Events :<span class="text-danger"></span></label>
                    <select class="single-select" name="EventId" id="EventId">
                        <option value=""> -- Select -- </option>
                        @if (lstEvents != null)
                        {
                            foreach (var item in lstEvents)
                            {
                                <option @(EventId == item.EventId ? "selected = selected" : "") value="@item.EventId">@item.EventName </option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search  <span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch" placeholder="Name">
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="Onload(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>
            <div class="col-lg-5 col-2 text-end">

                @if (IsExport == true)
                {
                    <div class="btn-align">
                        @*<a class="btn btn-primary" onclick="ExporttoExcel();" style="white-space: nowrap;">Export Details to Excel</a>*@
                        <a class="cursor-pointer do" data-bs-toggle="tooltip" style="border: 0;background: transparent;border: 1px solid #e8e6e7;padding: 10px;border-radius: 50%;/*! width: 100px; */background-color: #e8e6e7;" onclick="ExporttoExcel();" aria-label="Export Data ">
                            <i class="lni lni-download" style="font-size: 20px; color: black;"></i>
                        </a>
                    </div>
                }
                </div>
        </div>
    </div>
    <div id="divDetails" class="box-body table-responsive">

      
    </div>
</div>


