         function formatPhone(val) {
            var ph = val.replace(/\D/g, '').slice(0, 10);   // AU mobile = 10 digits max
            if (ph.length > 6) return ph.slice(0, 4) + '-' + ph.slice(4, 7) + '-' + ph.slice(7, 10);
            if (ph.length > 4) return ph.slice(0, 4) + '-' + ph.slice(4);
            return ph;
        }
    const phoneNumber = document.getElementById("phoneNumber");
    if (phoneNumber) {
        phoneNumber.addEventListener("input", function () {
            const formattedNumber = formatPhoneNumber(this.value);
            this.value = formattedNumber;
        });
    }

