                        <th style="text-align:center">Admin Comments</th>
                        <th style="text-align:center">Last Modified by</th>
                        <th style="text-align:center">Last Modified Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstMemberLogs.Count != 0)
                    {
                        Int64 i = 1;
                        foreach (var item in lstMemberLogs)
                        {
                            <tr>
                                <td style="text-align:center">@i</td>
                                <td>
                                    <div class="align-items-center gap-3 cursor-pointer">
                                        <div><p class="mb-0">@item.FirstName</p></div>
                                    </div>
                                </td>
                                <td>@item.LastName</td>
                                <td style="text-align:left">
                                    <div class="align-items-center gap-3 cursor-pointer">
                                        <div>
                                            <a href="mailto:@item.Email"><p class="mb-0">@item.Email</p></a>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.MobilePhone</td>
                                <td>@item.State</td>
                                <td>@item.City</td>
                                <td>@item.ZipCode</td>
                                <td>@item.Address</td>
                                <td>@item.Address2</td>
                                <td>@item.MembershipType</td>
                                <td>@item.PaymentMethod</td>
                                <td>@item.TransactionId</td>
                                <td>@item.PaymentStatus</td>
                                <td>@item.UserComment</td>
                                <td>@item.AdminComment</td>
                                <td>@item.UpdatedBy</td>
                                <td style="text-align:center">
                                    <span style="color: #990033">@(item.UpdatedTime.ToString("MM-dd-yyyy"))</span>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="18" class="font-14 text-center">No Records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var _URL = window.URL || window.webkitURL;
    $("#file").change(function (e) {
        var file, img;
        if ((file = this.files[0])) {
            img = new Image();
            img.onload = function () {
                if (this.width == 350 && this.height == 250) {
                    $('#hdnimgvalidate').val('1');
                } else {
                    $('#hdnimgvalidate').val('0');
                }
            };
            img.src = _URL.createObjectURL(file);
        }
    });

    function scrollToSection() {
        $('#MemberLogsId').show();
        const targetElement = document.getElementById("MemberLogsId");
        if (targetElement) {
            const offset = 100;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;
            window.scrollTo({ top: offsetPosition, behavior: "smooth" });
        } else {
            console.error("Element with id 'MemberLogsId' not found.");
        }
    }
           $(document).ready(function () {
        bindChildDOB(); // init datepickers for server-rendered rows on page load
    });

    function bindChildDOB(selector) {
        var target = selector ? selector : '.childDOB';
        $(target).datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: "-25:+0",
            dateFormat: 'dd/mm/yy',   // ✅ Australian format
            maxDate: 0,               // no future dates
            onSelect: function (dateText) {
                var age = calculateChildAge(dateText);
                $(this).closest('tr').find('input[id^="Age-"]').val(age);
            }
        });
    }

    function calculateChildAge(dobText) {
        // ✅ Parse using the same dd/mm/yy format as the datepicker (avoids US mm/dd/yyyy misparsing)
        var dob = $.datepicker.parseDate('dd/mm/yy', dobText);
        var today = new Date();
        var age = today.getFullYear() - dob.getFullYear();
        var m = today.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
            age--;
        }
        return age >= 0 ? age : '';
    }
</script>

