<script>
    function getStatusBadge(status) {
        if (!status) return '<span class="badge bg-secondary text-white" style="font-size:13px;padding:5px 10px;">N/A</span>';
        var s = status.toUpperCase();

        if (s === 'ACTIVE')
            return '<span class="badge bg-success text-white" style="font-size:13px;padding:5px 10px;">✔ ACTIVE</span>';
        else if (s === 'PENDING')
            return '<span class="badge bg-warning text-dark" style="font-size:13px;padding:5px 10px;">⏳ PENDING</span>';
        else if (s === 'START SCHEDULED')                             // ✅ NEW
            return '<span class="badge text-white" style="background:#0d6efd;font-size:13px;padding:5px 10px;">🔵 START SCHEDULED</span>';
        else if (s === 'CANCELLATION SCHEDULED')
            return '<span class="badge bg-warning text-dark" style="font-size:13px;padding:5px 10px;">⚠ CANCELLATION SCHEDULED</span>';
        else if (s === 'CANCELED' || s === 'CANCELLED')
            return '<span class="badge bg-danger text-white" style="font-size:13px;padding:5px 10px;">✖ CANCELED</span>';
        else if (s === 'PAUSED')
            return '<span class="badge bg-info text-white" style="font-size:13px;padding:5px 10px;">⏸ PAUSED</span>';
        else if (s === 'DEACTIVATED')
            return '<span class="badge bg-danger text-white" style="font-size:13px;padding:5px 10px;">⛔ DEACTIVATED</span>';
        else
            return '<span class="badge bg-secondary text-white" style="font-size:13px;padding:5px 10px;">' + status + '</span>';
    }

    // ── STEP 2: Open modal and call API ──────────────────────────────────
    function showSquareSubscriptionDetails(subscriptionId) {
        $('#squareModalContent').html(`
        <div class="text-center p-4">
            <i class="fa fa-spinner fa-spin fa-2x text-warning"></i>
            <p>Loading Square Subscription...</p>
        </div>`);
        $('#squareSubscriptionModal').modal('show');

        $.ajax({
            url: 'Admin/Members/GetSquareSubscriptionDetails',
            type: 'GET',
            data: { subscriptionId: subscriptionId },
            success: function (data) {
                console.log('Square Response:', JSON.stringify(data));
                console.log('Status value:', data.Status); // ← debug line
                if (data.Error) {
                    $('#squareModalContent').html(
                        `<div class="alert alert-danger">${data.Error}</div>`);
                    return;
                }
                renderSquarePopup(data);
            },
            error: function (xhr) {
                console.log('Square AJAX Error:', xhr.responseText);
                $('#squareModalContent').html(
                    `<div class="alert alert-danger">Failed to load subscription details.</div>`);
            }
        });
    }
    function renderSquarePopup(data) {
        var statusBadge = getStatusBadge(data.Status);

        // ✅ Next Billing Date row — always show
        var nextBillingRow = '';
        if (data.StartDate) {
            var s = data.Status ? data.Status.toUpperCase() : '';
            var noteText = (s === 'START SCHEDULED')
                ? 'Next billing on this date'
                : (s === 'PENDING')
                    ? 'First billing on this date'
                    : 'Auto debit on this date';

            nextBillingRow = `
            <tr style="background:#e8f5e9;">
                <td><b>Next Billing Date</b></td>
                <td style="color:#2e7d32; font-weight:600;">
                    <i class="fa fa-calendar"></i> ${data.StartDate}
                    &nbsp;<small class="text-muted">(${noteText})</small>
                </td>
            </tr>`;
        }

        // ✅ Charged Through row
        var chargedThroughRow = '';
        if (data.ChargeAt) {
            chargedThroughRow = `
            <tr style="background:#f0f4ff;">
                <td><b>Charged Through Date</b></td>
                <td style="color:#1a237e; font-weight:600;">
                    <i class="fa fa-check-circle"></i> ${data.ChargeAt}
                </td>
            </tr>`;
        }

        // ✅ Cancellation Scheduled row
        var cancelledRow = '';
        if (data.CancelledDate) {
            cancelledRow = `
            <tr style="background:#fff3cd;">
                <td><b>Subscription Ends On</b></td>
                <td style="color:#856404; font-weight:600;">
                    <i class="fa fa-calendar-times-o"></i> ${data.CancelledDate}
                    &nbsp;<small class="text-muted">(Next billing cancelled)</small>
                </td>
            </tr>`;
        }

        var html = `
        <table class="table table-bordered table-sm">
            <tr style="background:#fff8e1;">
                <td><b>Name:</b> <span class="text-danger">${data.CustomerName || 'N/A'}</span></td>
                <td><b>Email:</b> <span class="text-danger">${data.CustomerEmail || 'N/A'}</span></td>
                <td><b>Phone:</b> <span class="text-danger">${data.CustomerPhone || 'N/A'}</span></td>
            </tr>
        </table>

        <table class="table table-bordered table-sm">
            <tr>
                <td width="35%"><b>Status</b></td>
                <td>${statusBadge}</td>
            </tr>

            ${nextBillingRow}
            ${chargedThroughRow}
            ${cancelledRow}

            <tr>
                <td><b>Subscription Created At</b></td>
                <td>${data.CreatedAt || 'N/A'}</td>
            </tr>
            <tr>
                <td><b>Card</b></td>
                <td>
                    ${data.PaymentMethod || ''}
                    ${data.CardLast4 ? '**** **** **** ' + data.CardLast4 : 'N/A'}
                    ${data.CardExpiry ? '&nbsp;&nbsp; Exp: ' + data.CardExpiry : ''}
                </td>
            </tr>
            <tr>
                <td><b>Card ID</b></td>
                <td><small>${data.CardMandateId || 'N/A'}</small></td>
            </tr>
            <tr>
                <td><b>Subscription Link</b></td>
                <td>
                    <a href="${data.SubscriptionLink}" target="_blank" class="btn btn-xs btn-warning">
                        <i class="fa fa-external-link"></i> Open in Square
                    </a>
                </td>
            </tr>
        </table>`;

        $('#squareModalContent').html(html);
    }</script>

