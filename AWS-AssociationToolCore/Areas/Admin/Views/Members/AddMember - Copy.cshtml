                            <div class="input-box">
                                <label class="form-label">ZipCode </label>
                                <input type="text" id="ZipCode" class="form-control" name="ZipCode" placeholder="ZipCode" onkeypress="return Common.isNumberKey(event);" maxlength="8">
                            </div>
                        </div>


                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Marital Status <span class="text-danger">*</span></label>
                                <select class="single-select" name="MaritalStatus" id="MaritalStatus" placeholder="Marital Status">
                                    <option value="">-- Select --</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Gender <span class="text-danger">*</span></label>
                                <select class="single-select" name="gender" id="gender" placeholder="Gender">
                                    <option value="">-- Select --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>

                        @if (objAppInfo.chapterStatus == "Yes")
