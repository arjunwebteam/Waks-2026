     function formatPhone(val) {
        var ph = val.replace(/\D/g, '').slice(0, 10);   // AU mobile = 10 digits max
        if (ph.length > 6) return ph.slice(0, 4) + '-' + ph.slice(4, 7) + '-' + ph.slice(7, 10);
        if (ph.length > 4) return ph.slice(0, 4) + '-' + ph.slice(4);
        return ph;
    }

      function handlePaste(event) {
        if (event.target.id === "SelfMobilePhone") {   // ✅ updated id
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            event.target.value = formatPhone(pastedNumber);
            event.preventDefault();
        }
    }

    function handlePastes(event) {
        if (event.target.id === "SpouseCell") {
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            const formattedNumber = formatPhone(pastedNumber);   // ✅ formatPhone, not formatPhoneNumber
            event.target.value = formattedNumber;
            event.preventDefault();
        }
    }

