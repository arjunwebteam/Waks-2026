    function calculateExpiryDate(startDate, months) {
        // Create a new Date object based on the provided start date
        const startDateObj = new Date(startDate);

        // Add the specified number of months to the start date
        startDateObj.setMonth(startDateObj.getMonth() + months);

        // Return the calculated expiry date
        return startDateObj;
    }





    $(document).ready(function () {
        $('#ChequeHolderNamehide').hide()
        $('#ZellePartnerNamehide').hide()
        $("#BannerUrl").change(function () {
            validateBannerUrl();
        });

        function validateBannerUrl() {
            $("#FormWebBanners").validate().resetForm();
            $("#FormWebBanners").validate().element("#BannerUrl");
        }

        $.validator.addMethod("validImageExtension", function (value, element) {
            if (element.files && element.files.length > 0) {
                var allowedExtensions = ["jpg", "png", "gif", "jpeg"];
                var fileName = element.files[0].name;
                var extension = fileName.split('.').pop().toLowerCase();
                return $.inArray(extension, allowedExtensions) !== -1;
            }
            return true;
        }, "Only allowed extensions are: jpg, png, gif, jpeg");




        $('.modal').on('hidden.bs.modal', function () {
            // Reset form fields
            $('#FormWebBanners')[0].reset();

            // Reset form validations
            validateForm.resetForm();

            // Clear validation classes
            $('.modal').find('.error').removeClass('is-valid is-invalid');
            $('.modal').find('.form-control').removeClass('is-valid is-invalid');
        });
    });



    function getamount() {
        var membershipid = $('#MembershipTypeId').val();
        $.ajax({
            url: '@Url.Action("EditMembershipTypes", "MembershipTypes")',
            type: 'POST',
            data: { MembershipTypeId: membershipid },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objMembershipType = result.data;
                    $('#payamount').html(objMembershipType.Price);
                    $('#MemberAmount').val(objMembershipType.Price);
                    $('#TMemberAmount').val(objMembershipType.Price);
                    $('#total').html(objMembershipType.Price);
                    if (objMembershipType.Validity != 0) {
                        const startDate = new Date(); // current date

                        const formattedDate = startDate.toLocaleString('en-US', {
                            year: 'numeric',
                            month: 'numeric',
                            day: 'numeric',
                            hour: 'numeric',
                            minute: 'numeric',
                            second: 'numeric',
                            hour12: true
                        });

                        const monthsToAdd = objMembershipType.Validity;
                        const expiryDate = calculateExpiryDate(formattedDate, monthsToAdd);
                        $('#ExpiryDate').val(expiryDate.toString("MM/dd/yyyy"));

                    }
                    else {
                        $('#ExpiryDate').val('Life Time');

                    }

                    //if (Common.ConvertDate(objMembershipType.Validity) != '1/1/1') {
                    //    var d = new Date();
                    //    d.setMonth((d.getMonth()) + objMembershipType.Validity);
                    //    $('#ExpiryDate').val(Common.ConvertDate(objMembershipType.Validity));
                    //} else { $('#ExpiryDate').val('Life Time'); }
                }
                else {
                    alert(result.data);
                }
            }
        });
    }
    function PaymentMethodBind() {

        var PaymentMethod = $('#PaymentMethodId').val();
        if (PaymentMethod == 3) {
            $('#ChequeHolderNamehide').show()
            $('#ZellePartnerNamehide').hide()
        }
        else if (PaymentMethod == 6) {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').show()
        }
        else {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').hide()
        }
    }
</script>
