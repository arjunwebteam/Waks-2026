<script type="text/javascript">
    $(document).ready(function () {
        function forceCorrectFormat(el) {
            setTimeout(function () {
                el.value = formatPhone(el.value);
            }, 0);
        }

        // Personal Details Mobile Phone
        var selfPhone = document.getElementById('SelfMobilePhone');
        if (selfPhone) {
            selfPhone.addEventListener('blur', function () { forceCorrectFormat(selfPhone); });
            selfPhone.addEventListener('change', function () { forceCorrectFormat(selfPhone); });
        }

        // Spouse Mobile Phone
        var spousePhone = document.getElementById('SpouseCell');
        if (spousePhone) {
            spousePhone.addEventListener('blur', function () { forceCorrectFormat(spousePhone); });
            spousePhone.addEventListener('change', function () { forceCorrectFormat(spousePhone); });
        }
    });
</script>
<script type="text/javascript">

