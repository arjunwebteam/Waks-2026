@using (Html.BeginForm("AddMember", "Members", FormMethod.Post, new { enctype = "multipart/form-data", @id = "VolunteerForm", @name = "VolunteerForm" }))
{
    <input type="hidden" value="" id="MemberAmount" name="MemberAmount" />
    <input type="hidden" value="" id="TMemberAmount" name="TMemberAmount" />
    <input type="hidden" id="Amount" name="Amount" value="" />


