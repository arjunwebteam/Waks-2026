                                <label class="form-label">Address-1</label>
                                <textarea type="text" id="Address" class="form-control" name="Address" placeholder="Address"></textarea>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Do you identify as Kannadiga</label>
                                <select class="single-select" name="Address2" id="Address2" placeholder="">
                                    <option value="">-- Select --</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="box validation">
                <div class="box-header">
                    <h3 class="box-title dis-in"> Spouse Details </h3>
                </div>
                <div class="box-body">
                    <div class="row  g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">First Name </label>
                                <input type="text" class="form-control" id="SpouseFirstName" name="SpouseFirstName" placeholder="Spouse First Name">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Last Name </label>
                                <input type="text" class="form-control" id="SpouseLastName" name="SpouseLastName" placeholder="Spouse Last Name">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Email</label>
                                <input type="text" class="form-control" id="SpouseEmail" name="SpouseEmail" placeholder="Spouse Email">
                            </div>
                        </div>
                        <!-- Spouse Details -->
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Mobile Phone <span class="text-danger"></span></label>
                                <input type="text" class="form-control" id="SpouseCell" name="SpouseCell"
                                       oninput="this.value = formatPhone(this.value);"
                                       maxlength="12" placeholder="0412-345-678"
                                       onpaste="handlePastes(event);" autocomplete="off" />
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">

            <div class="box validation">
                <div class="box-header">
                    <h3 class="box-title dis-in"> Latest Order Details </h3>
                </div>
                <div class="box-body">
                    <div class="row  g-3">

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">
                                    Membership Type : <span class="text-danger">*</span>
                                </label>

                                <select class="single-select" name="MembershipTypeId" id="MembershipTypeId" type="text" onchange="getamount();">
                                    @if (lstMembershipType != null)
                                    {
                                        <option value="">Select</option>
                                        foreach (var item in lstMembershipType)
                                        {
                                            <option value="@item.MembershipTypeId">@item.MembershipType</option>
                                        }
                                    }


                                </select>

                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Expiry Date </label>
                                <input type="text" class="form-control" id="ExpiryDate" name="ExpiryDate" readonly="true">


                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">

                            <div class="input-box">
                                <div>
                                    <label>&nbsp;</label>
                                </div>
                                <label>Amount :</label>
                                $<span id="payamount"></span>

                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Payment Method</label>

                                <select class="single-select" name="PaymentMethodId" id="PaymentMethodId" type="text" onchange="PaymentMethodBind();">
                                    @if (lstPaymentMethod != null)
                                    {
                                        <option value="">Select</option>
                                        foreach (var item in lstPaymentMethod)
                                        {
                                            <option value="@item.PaymentMethodId">@item.PaymentMethod</option>
                                        }
                                    }


                                </select>

                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6" id="ChequeHolderNamehide">
                            <div class="input-box">
                                <label class="form-label">Handed the cash/cheque to - Name of the :</label>
                                <input type="text" class="form-control" id="ChequeHolderName" name="ChequeHolderName">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6" id="ZellePartnerNamehide">
                            <div class="input-box">
                                <label class="form-label">Zelle Person Name </label>
                                <input type="text" class="form-control" id="ZellePartnerName" name="ZellePartnerName">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Transaction Id </label>
                                <input type="text" class="form-control" id="TransactionId" name="TransactionId">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Payment Status</label>

                                <select class="single-select" name="PaymentStatusId" id="PaymentStatusId" type="text">
                                    @if (lstPaymentStatus != null)
                                    {
                                        <option value="">Select</option>
                                        foreach (var item in lstPaymentStatus)
                                        {
                                            <option value="@item.PaymentStatusId">@item.PaymentStatus1</option>
                                        }
                                    }


                                </select>
                            </div>
                        </div>


                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Bank Name  :</label>
                                <input type="text" class="form-control" id="BankName" name="BankName">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Cheque Date :</label>
                                <input type="text" class="form-control" id="ChequeDate" name="ChequeDate">
                            </div>
                        </div>


                        <div class="col-lg-6 col-md-6">
                            <div class="input-box">
                                <label class="form-label">User Comments</label>
                                <textarea type="text" id="UserComment" class="form-control" name="UserComment" placeholder="UserComment"></textarea>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Admin Comments</label>
                                <textarea type="text" class="form-control" id="AdminComment" name="AdminComment" placeholder="AdminComment"></textarea>
                            </div>
                        </div>
                    </div>




                </div>

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-3 text-end ms-auto">
            <button type="submit" class="btn btn-success px-3 " value="submit"> Submit</button>
            <a class="btn btn-primary px-3" href="@Url.Action("Index", "Members", new { mid = ViewBag.mid })">Cancel</a>
        </div>
    </div>

}

















