@{
    ViewBag.Title = "AddVolunteer";
    ViewBag.Pageheading = "Add Volunteer";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    List<AWS_AssociationToolCore.Entities.VolunteerCategories> lstVolunteerCategory = ViewBag.lstVolunteerCategory;
    Int64 VolunteerCategoryId = ViewBag.VolunteerCategoryId;
    List<AWS_AssociationToolCore.Entities.Events> lstEvents = ViewBag.lstEvents;
    Int64 EventId = ViewBag.EventId;

    Int64 ChapterId = ViewBag.ChapterId;

    


    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;

    List<AWS_AssociationToolCore.Entities.country> lstCountries = new List<AWS_AssociationToolCore.Entities.country>();
    lstCountries = ViewBag.lstCountries;




    int status = 0;

    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
