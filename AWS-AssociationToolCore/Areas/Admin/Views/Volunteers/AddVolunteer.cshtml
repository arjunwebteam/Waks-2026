<div class="content">
    @using (Html.BeginForm("AddVolunteer", "Volunteers", FormMethod.Post, new { enctype = "multipart/form-data", @id = "VolunteerForm", @name = "VolunteerForm" }))
    {
        <input type="hidden" name="EventId" id="EventId" />



        if (objAppInfo.chapterStatus == "No")
        {
            <input type="hidden" value="1" name="ChapterId" id="ChapterId" />
        }

       

        <input type="hidden" value="@ViewBag.mid" name="mid" id="mid" />
        <div class="box validation">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">First Name : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="FirstName" id="FirstName" placeholder="FirstName">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Last Name : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="LastName" id="LastName" placeholder="LastName">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Email : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Email" id="Email" placeholder="Email">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">PhoneNo : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" onkeypress="return Common.isNumberKey(event);" onpaste="handlePaste(event);" maxlength="12" name="PhoneNo" id="PhoneNo" placeholder="PhoneNo">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">City : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="City" id="City" placeholder="City">
                            </div>
                        </div>



                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Country : <span class="text-danger">*</span></label>
                                <select class="form-control" id="Country" name="Country" @* onchange="StatesBind()" *@>
                                    <option value="">Select</option>
                                    @if (lstCountries.Count != 0)
                                    {
                                        foreach (var item in lstCountries)
                                        {
                                             <option value="@(item.CountryID)">@(item.CountryName)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">State : <span class="text-danger">*</span></label>
                                <select class="form-control" name="State" id="State" placeholder="State">
                                    <option value="">Select State</option>
                                    <option value="Australian Capital Territory">Australian Capital Territory</option>
                                    <option value="New South Wales">New South Wales</option>
                                    <option value="Northern Territory">Northern Territory</option>
                                    <option value="Queensland">Queensland</option>
                                    <option value="South Australia">South Australia</option>
                                    <option value="Tasmania">Tasmania</option>
                                    <option value="Victoria">Victoria</option>
                                    <option value="Western Australia">Western Australia</option>
                                       
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">ZipCode : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ZipCode" id="ZipCode" placeholder="ZipCode" maxlength="8" onkeypress="return Common.isNumberKey(event);">
                            </div>
                        </div>

                        @if (objAppInfo.chapterStatus == "Yes")
                        {
                            <div class="col-lg-3 col-md-6">
                                <div class="input-box">
                                    <label class="form-label">Chapters : </label>
                                   
                                    <select class="form-control" id="ChapterId" name="ChapterId" onchange="CategoriesBind();" style="@(ChapterId != 1 ? "pointer-events:none;" : "")">

                                        <option value="">-- Select --</option>
                                        @if (lstChapters != null && lstChapters.Count != 0)
                                        {
                                            foreach (var item in lstChapters)
                                            {
                                                
                                                <option value="@item.ChapterId" @(item.ChapterId == ChapterId ? "selected=selected" : "")>@item.ChapterName</option>


                                            }
                                        }
                                    </select>
</div>
                            </div>

                        }
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">
                                    Waks Category : <span class="text-danger">*</span>
                                </label>

                                <!-- ✅ hidden field holds final CSV value, posted to server -->
                                <input type="hidden" name="WaksCategoryId" id="WaksCategoryId" value="" />

                                <div class="dropdown waks-dropdown">
                                    <button class="form-control text-start d-flex justify-content-between align-items-center"
                                            type="button"
                                            id="WaksDropdownBtn"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <span id="WaksDropdownLabel">-- Select --</span>
                                        <i class="fa fa-caret-down"></i>
                                    </button>

                                    <div class="dropdown-menu p-2" style="width:100%; max-height:250px; overflow-y:auto;" aria-labelledby="WaksDropdownBtn">
                                        @foreach (var item in lstVolunteerCategory.Where(x => x.Type == "Waks"))
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input waks-chk"
                                                       type="checkbox"
                                                       value="@item.VolunteerCategoryId"
                                                       id="WaksChk-@item.VolunteerCategoryId" />
                                                <label class="form-check-label" for="WaksChk-@item.VolunteerCategoryId">
                                                    @item.CategoryName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="invalid-feedback" id="spanWaksCategoryError" style="display:none; color:#dc3545; font-size:.875em;"></div>
                            </div>
                        </div>
<div class="col-lg-3 col-md-6">
    <div class="input-box">
        <label class="form-label">
            Kannada Shaale Category : <span class="text-danger">*</span>
        </label>

        <select class="single-select" name="KannadaCategoryId" id="KannadaCategoryId">
            <option value="">-- Select --</option>

            @foreach (var item in lstVolunteerCategory.Where(x => x.Type == "Kannada Shaale"))
            {
                <option value="@item.VolunteerCategoryId">
                    @item.CategoryName
                </option>
            }
        </select>
    </div>
</div>
