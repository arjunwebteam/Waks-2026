    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);




}
<script type="text/javascript">
    $(document).ready(function () {
        function forceCorrectFormat(el) {
            setTimeout(function () {
                el.value = formatPhone(el.value);
            }, 0);
        }

        // Personal Details Mobile Phone
        var selfPhone = document.getElementById('PhoneNo');
        if (selfPhone) {
            selfPhone.addEventListener('blur', function () { forceCorrectFormat(selfPhone); });
            selfPhone.addEventListener('change', function () { forceCorrectFormat(selfPhone); });
        }

    });
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#wVolunteer, #wVolunteers').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
    });

    $(document).ready(function () {

        // ✅ Sync checked Waks checkboxes → hidden CSV field + update button label
        $(document).on('change', '.waks-chk', function () {
            var selected = [];
            var names = [];
            $('.waks-chk:checked').each(function () {
                selected.push($(this).val());
                names.push($(this).next('label').text().trim());
            });

            $('#WaksCategoryId').val(selected.join(','));
            $('#WaksCategoryId').valid();

            if (names.length === 0) {
                $('#WaksDropdownLabel').text('-- Select --');
            } else if (names.length <= 2) {
                $('#WaksDropdownLabel').text(names.join(', '));
            } else {
                $('#WaksDropdownLabel').text(names.length + ' categories selected');
            }
        });
            $.validator.addMethod('phoneFormat', function (value, element) {
        var phone = value.replace(/\D/g, '');
        return this.optional(element) || /^0[234789]\d{8}$/.test(phone);
    }, 'Please enter a valid  phone number');
        // ✅ Prevent dropdown from closing when clicking inside checkboxes
        $(document).on('click', '.waks-dropdown .dropdown-menu', function (e) {
            e.stopPropagation();
        });

        $("#VolunteerForm").validate({
            rules: {
                FirstName: "required",
                LastName: "required",
                WaksCategoryId: "required",
                KannadaCategoryId: "required",
                Email: {
                    required: true,
                    email: true
                },
             
                       PhoneNo:  { required: true, phoneFormat: true },
                City: "required",
                Country: "required",
                State: "required",
                ZipCode: "required",
            },
            messages: {
                FirstName: " First Name is required",
                LastName: " Last Name is required",
                WaksCategoryId: " Please select at least one Waks category",
                KannadaCategoryId: " Please Select Kannada Interest Category",
                Email: {
                    required: "Please enter email address",
                    email: "Please enter valid email address",
                },
                PhoneNo: {
                    required: "Please enter phone number",
                     phoneFormat: 'Please enter a valid  phone number'
                },
                City: " City is required",
                Country: " Country is required",
                State: " State is required",
                ZipCode: " ZipCode is required",
            },
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");

                if (element.attr("id") === "WaksCategoryId") {
                    $("#spanWaksCategoryError").html(error).show();
                    return;
                }

                if (element.closest(".input-box").length) {
                    element.closest(".input-box").after(error);
                } else {
                    error.insertAfter(element);
                }
            },
            highlight: function (element) {
                var name = $(element).attr("name");
                if (name === "WaksCategoryId") return;
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                var name = $(element).attr("name");
                if (name === "WaksCategoryId") {
                    $("#spanWaksCategoryError").hide();
                    return;
                }
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            submitHandler: function (form) {
                var selected = [];
                $('.waks-chk:checked').each(function () {
                    selected.push($(this).val());
                });
                $('#WaksCategoryId').val(selected.join(','));
                form.submit();
            }
        });

        $('#KannadaCategoryId').on('change', function () {
            $(this).valid();
        });

    });

        function StatesBind() {
        var CountryID = $('#Country').val();
        $.ajax({
            url: '@Url.Action("GetStateByCountryID", "Volunteers")',
            type: 'POST',
            data: { CountryID: CountryID }, // optional data
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var sb = "<option value=\"\">-- Select --</option>";
                    States = result.data;
                    if (States != null) {
                        for (var i = 0; i < States.length; i++) {
                            sb = sb + "<option value=\"" + States[i].StateID + "\">" + States[i].StateName + "</option>";
                        }
                    }
                    $('#State').html(sb);
                }
            }
        });
    }

 


       function CategoriesBind() {
           var ChapterId = $('#ChapterId').val();
           

        $.ajax({
            url: '@Url.Action("VolunteerCategoriesGetChapterId", "VolunteerCategories")',
            type: 'POST',
            data: { ChapterId: ChapterId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {

                    var lstVolunteerCategories = result.data;
                    var sb = "<label>Volunteer Category : <span>*</span></label>";
                    sb = sb + "<select id=\"VolunteerCategoryId\" name=\"VolunteerCategoryId\" class=\"form-control\">";
                    sb = sb + "<option value=\"\">Select</option>";
                    if (lstVolunteerCategories != null) {
                        for (var i = 0; i < lstVolunteerCategories.length; i++) {
                            sb = sb + "<option  value=\"" + lstVolunteerCategories[i].VolunteerCategoryId + "\">" + lstVolunteerCategories[i].CategoryName + "</option>";

                        }
                    }
                    sb = sb + "</select>";
                    $('#divVolunteerCategory').html('');
                    $('#divVolunteerCategory').html(sb);
                    window.asd = $('.form-control').SumoSelect({ csvDispCount: 3, selectAll: true, search: true, searchText: 'Enter here.', captionFormatAllSelected: "Yeah, OK, so everything." });
                }
            }
        });
    }

         function formatPhone(val) {
        var ph = val.replace(/\D/g, '').slice(0, 10);   // AU mobile = 10 digits max
        if (ph.length > 6) return ph.slice(0, 4) + '-' + ph.slice(4, 7) + '-' + ph.slice(7, 10);
        if (ph.length > 4) return ph.slice(0, 4) + '-' + ph.slice(4);
        return ph;
    }

      function handlePaste(event) {
        if (event.target.id === "PhoneNo") {   // ✅ updated id
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            event.target.value = formatPhone(pastedNumber);
            event.preventDefault();
        }
    }

    
   
</script>
