<div class="content">
    @using (Html.BeginForm("AddVolunteer", "Volunteers", FormMethod.Post, new { enctype = "multipart/form-data", @id = "VolunteerForm", @name = "VolunteerForm" }))
    {
        <input type="hidden" name="VolunteerId" id="VolunteerId" value="@objTemplates.VolunteerId" />


        if (objAppInfo.chapterStatus == "No")
        {
            <input type="hidden" value="1" name="ChapterId" id="ChapterId" />
        }
       

        <input type="hidden" value="@ViewBag.mid" name="mid" id="mid" />

        <div class="box validation">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">First Name : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="FirstName" id="FirstName" value="@objTemplates.FirstName" placeholder="FirstName">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Last Name : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="LastName" id="LastName" value="@objTemplates.LastName" placeholder="LastName">
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Email : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Email" id="Email" value="@objTemplates.Email" placeholder="Email">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Mobile Phone <span class="text-danger"></span></label>
                                <input type="text" class="form-control" value="@objTemplates.PhoneNo" id="PhoneNo" name="PhoneNo"
                                       oninput="this.value = formatPhone(this.value);"
                                       autocomplete="off" maxlength="12" placeholder="0412-345-678"
                                       onpaste="handlePaste(event);" />
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">City : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" value="@objTemplates.City" name="City" id="City" placeholder="PhoneNo">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Country : </label>
                                <select class="single-select" id="Country" name="Country" onchange="StatesBind()">
                                    <option value="">Select</option>
                                    @if (lstCountries.Count != 0)
                                    {
                                        foreach (var item in lstCountries)
                                        {
                                            <option @(item.CountryID == Convert.ToInt64(objTemplates.Country) ? "selected=selected" : "") value="@item.CountryID">@item.CountryName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">State : </label>
                                <select class="single-select" name="State" id="State">
                                    <option @(objTemplates.State == "Australian Capital Territory" ? "selected=selected" : "") value="Australian Capital Territory">Australian Capital Territory</option>
                                    <option @(objTemplates.State == "New South Wales" ? "selected=selected" : "") value="New South Wales">New South Wales</option>
                                    <option @(objTemplates.State == "Northern Territory" ? "selected=selected" : "") value="Northern Territory">Northern Territory</option>
                                    <option @(objTemplates.State == "Queensland" ? "selected=selected" : "") value="Queensland">Queensland</option>
                                    <option @(objTemplates.State == "South Australia" ? "selected=selected" : "") value="South Australia">South Australia</option>
                                    <option @(objTemplates.State == "Tasmania" ? "selected=selected" : "") value="Tasmania">Tasmania</option>
                                    <option @(objTemplates.State == "Victoria" ? "selected=selected" : "") value="Victoria">Victoria</option>
                                    <option @(objTemplates.State == "Western Australia" ? "selected=selected" : "") value="Western Australia">Western Australia</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">ZipCode : <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ZipCode" id="ZipCode" placeholder="ZipCode" maxlength="8" value="@objTemplates.ZipCode" onkeypress="return Common.isNumberKey(event);">
                            </div>
                        </div>
                        @if (objAppInfo.chapterStatus == "Yes")
                        {
                            <div class="col-lg-3 col-md-6">
                                <div class="input-box">
                                    <label class="form-label">Chapters : </label>
                                  
                                   
                                        <select class="form-control" id="ChapterId" name="ChapterId" onchange="CategoriesBind();" style="@(ChapterId != 1 ? "pointer-events:none;" : "")">

                                            <option value="">-- Select --</option>
                                            @if (lstChapters != null && lstChapters.Count != 0)
                                            {
                                                foreach (var item in lstChapters)
                                                {
                                                    <option @(item.ChapterId == objTemplates.ChapterId ? "selected=selected" : "") value="@item.ChapterId">@item.ChapterName</option>

                                                }
                                            }
                                        </select>
</div>
                            </div>

                        }
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">
                                    Waks Category : <span class="text-danger">*</span>
                                </label>

                                @{
                                    var savedWaksIds = string.IsNullOrEmpty(objTemplates.WaksCategoryId)
                                    ? new List<string>()
                                    : objTemplates.WaksCategoryId.Split(',').Select(x => x.Trim()).ToList();

                                    var waksCategoryList = (List<AWS_AssociationToolCore.Entities.VolunteerCategories>)ViewBag.WaksCategories;

                                    // ✅ Build initial label directly from selected names
                                    var selectedWaksNames = waksCategoryList
                                    .Where(x => savedWaksIds.Contains(x.VolunteerCategoryId.ToString()))
                                    .Select(x => x.CategoryName)
                                    .ToList();

                                    string initialWaksLabel = "-- Select --";
                                    if (selectedWaksNames.Count == 1)
                                    {
                                        initialWaksLabel = selectedWaksNames[0];
                                    }
                                    else if (selectedWaksNames.Count > 1 && selectedWaksNames.Count <= 2)
                                    {
                                        initialWaksLabel = string.Join(", ", selectedWaksNames);
                                    }
                                    else if (selectedWaksNames.Count > 2)
                                    {
                                        initialWaksLabel = selectedWaksNames.Count + " categories selected";
                                    }
                                }

                                <input type="hidden" name="WaksCategoryId" id="WaksCategoryId" value="@objTemplates.WaksCategoryId" />

                                <div class="dropdown waks-dropdown">
                                    <button class="form-control text-start d-flex justify-content-between align-items-center"
                                            type="button"
                                            id="WaksDropdownBtn"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <span id="WaksDropdownLabel">@initialWaksLabel</span>
                                        <i class="fa fa-caret-down"></i>
                                    </button>

                                    <div class="dropdown-menu p-2" style="width:100%; max-height:250px; overflow-y:auto;" aria-labelledby="WaksDropdownBtn">
                                        @foreach (var item in waksCategoryList)
                                        {
                                            bool isChecked = savedWaksIds.Contains(item.VolunteerCategoryId.ToString());
                                            <div class="form-check">
                                                <input class="form-check-input waks-chk"
                                                       type="checkbox"
                                                       value="@item.VolunteerCategoryId"
                                                       id="WaksChk-@item.VolunteerCategoryId"
                                                       @(isChecked ? "checked=checked" : "") />
                                                <label class="form-check-label" for="WaksChk-@item.VolunteerCategoryId">
                                                    @item.CategoryName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="invalid-feedback" id="spanWaksCategoryError" style="display:none; color:#dc3545; font-size:.875em;"></div>
                            </div>
                        </div>
